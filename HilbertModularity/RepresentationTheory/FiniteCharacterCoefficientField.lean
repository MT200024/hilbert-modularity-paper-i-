module

public import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.Topology.LocallyConstant.Basic

/-! # Coefficient fields of finite-image characters

The values of a finite-image character generate a finite extension of any
number field already embedded in its local coefficient field. -/

public noncomputable section

namespace MonoidHom

variable {G E₀ L : Type*} [Group G] [Field E₀] [Field L]

/-- A value of a finite-image character is integral over every coefficient
field embedded in its codomain. -/
theorem isIntegral_value_of_finite_range [Algebra E₀ L]
    (ν : G →* Lˣ) (hν : (Set.range ν).Finite) (g : G) :
    IsIntegral E₀ (ν g : L) := by
  let : Finite ν.range := hν.to_subtype
  obtain ⟨n, hn, hp⟩ := (isOfFinOrder_of_finite (ν.rangeRestrict g)).exists_pow_eq_one
  have hpow : (ν g : L) ^ n = 1 := by
    simpa using congrArg (fun x : Set.range ν => ((x : Lˣ) : L)) hp
  exact IsIntegral.of_pow hn (by rw [hpow]; exact isIntegral_one)

end MonoidHom

namespace HilbertModularity.RepresentationTheory

variable {G E₀ L : Type*} [Group G] [Field E₀] [Field L] [Algebra E₀ L]

/-- The subfield of a coefficient field generated by the values of a given
character and a specified embedded ground field. -/
def finiteCharacterCoefficientField (ν : G →* Lˣ) : IntermediateField E₀ L :=
  IntermediateField.adjoin E₀ (Set.range fun g => (ν g : L))

/-- The given character's values belong to its generated coefficient field. -/
theorem finiteCharacterCoefficientField_mem (ν : G →* Lˣ) (g : G) :
    (ν g : L) ∈ finiteCharacterCoefficientField (E₀ := E₀) ν := by
  exact IntermediateField.subset_adjoin E₀ _ (Set.mem_range_self g)

/-- A finite-image character generates a finite extension of the original
coefficient field. -/
theorem finiteDimensional_finiteCharacterCoefficientField
    (ν : G →* Lˣ) (hν : (Set.range ν).Finite) :
    FiniteDimensional E₀ (finiteCharacterCoefficientField (E₀ := E₀) ν) := by
  have hfinite : (Set.range fun g => (ν g : L)).Finite := by
    convert hν.image (fun u : Lˣ => (u : L)) using 1
    ext x
    simp only [Set.mem_range, Set.mem_image]
    aesop
  let : Finite (Set.range fun g => (ν g : L)) := hfinite.to_subtype
  exact IntermediateField.finiteDimensional_adjoin (by
    rintro x ⟨g, rfl⟩
    exact ν.isIntegral_value_of_finite_range hν g)

/-- The generated coefficient field is a number field whenever the original
coefficient field is one. -/
theorem numberField_finiteCharacterCoefficientField [NumberField E₀]
    (ν : G →* Lˣ) (hν : (Set.range ν).Finite) :
    NumberField (finiteCharacterCoefficientField (E₀ := E₀) ν) := by
  let : FiniteDimensional E₀ (finiteCharacterCoefficientField (E₀ := E₀) ν) :=
    finiteDimensional_finiteCharacterCoefficientField (E₀ := E₀) ν hν
  let : FiniteDimensional ℚ (finiteCharacterCoefficientField (E₀ := E₀) ν) :=
    FiniteDimensional.trans ℚ E₀ (finiteCharacterCoefficientField (E₀ := E₀) ν)
  exact ⟨⟩

/-- The original coefficient embedding factors through the generated field. -/
theorem finiteCharacterCoefficientField_subtype_comp_algebraMap
    (ν : G →* Lˣ) :
    (finiteCharacterCoefficientField (E₀ := E₀) ν).subtype.comp
      (algebraMap E₀ (finiteCharacterCoefficientField (E₀ := E₀) ν)) = algebraMap E₀ L := by
  ext x
  rfl

/-- Corestriction of the character to the number field generated by its
values. Its definition does not depend on a finite-range witness. -/
def finiteCharacterCorestrict (ν : G →* Lˣ) :
    G →* (finiteCharacterCoefficientField (E₀ := E₀) ν)ˣ where
  toFun g := Units.mk0 ⟨(ν g : L), finiteCharacterCoefficientField_mem ν g⟩ (by
    intro h
    have hh : (ν g : L) = 0 := congrArg Subtype.val h
    exact (ν g).ne_zero hh)
  map_one' := by
    apply Units.ext
    apply Subtype.ext
    simp
  map_mul' g h := by
    apply Units.ext
    apply Subtype.ext
    simp

/-- Inclusion into the original local coefficient field recovers exactly the
given character. -/
theorem finiteCharacterCorestrict_map (ν : G →* Lˣ) :
    (Units.map (finiteCharacterCoefficientField (E₀ := E₀) ν).subtype.toMonoidHom).comp
      (finiteCharacterCorestrict (E₀ := E₀) ν) = ν := by
  apply MonoidHom.ext
  intro g
  apply Units.ext
  rfl

/-- Corestriction preserves finite image. -/
theorem finiteCharacterCorestrict_finite_range (ν : G →* Lˣ)
    (hν : (Set.range ν).Finite) :
    (Set.range (finiteCharacterCorestrict (E₀ := E₀) ν)).Finite := by
  let f := Units.map (finiteCharacterCoefficientField (E₀ := E₀) ν).subtype.toMonoidHom
  apply Set.Finite.of_finite_image (f := f) ?_
    (Units.map_injective (fun _ _ h => Subtype.ext h)).injOn
  have hcomp : (f ∘ finiteCharacterCorestrict (E₀ := E₀) ν : G → Lˣ) = ν := by
    funext g
    exact congrArg (fun χ : G →* Lˣ => χ g)
      (finiteCharacterCorestrict_map (E₀ := E₀) ν)
  rw [← Set.range_comp, hcomp]
  exact hν

/-- The descended character is locally constant when the original
finite-image character is continuous into a Hausdorff field. -/
theorem finiteCharacterCorestrict_isLocallyConstant
    [TopologicalSpace G] [TopologicalSpace L] [T2Space L]
    (ν : G →* Lˣ) (hν : (Set.range ν).Finite) (hc : Continuous ν) :
    IsLocallyConstant (finiteCharacterCorestrict (E₀ := E₀) ν) := by
  let : Finite (Set.range ν) := hν.to_subtype
  have hc' : Continuous (fun g => (⟨ν g, Set.mem_range_self g⟩ : Set.range ν)) :=
    hc.subtype_mk _
  have hlc : IsLocallyConstant
      (fun g => (⟨ν g, Set.mem_range_self g⟩ : Set.range ν)) :=
    (IsLocallyConstant.iff_continuous _).mpr hc'
  let f : Set.range ν → (finiteCharacterCoefficientField (E₀ := E₀) ν)ˣ :=
    fun u => finiteCharacterCorestrict (E₀ := E₀) ν (Classical.choose u.property)
  let j := Units.map (finiteCharacterCoefficientField (E₀ := E₀) ν).subtype.toMonoidHom
  have hj : Function.Injective j :=
    Units.map_injective (fun _ _ h => Subtype.ext h)
  have hmap (g : G) : j (finiteCharacterCorestrict (E₀ := E₀) ν g) = ν g := by
    exact congrArg (fun χ : G →* Lˣ => χ g) (finiteCharacterCorestrict_map (E₀ := E₀) ν)
  have hf : (fun g => f ⟨ν g, Set.mem_range_self g⟩) =
      finiteCharacterCorestrict (E₀ := E₀) ν := by
    funext g
    apply hj
    calc
      j (f ⟨ν g, Set.mem_range_self g⟩) =
          ν (Classical.choose (Set.mem_range_self g)) := hmap _
      _ = ν g := Classical.choose_spec (Set.mem_range_self g)
      _ = j (finiteCharacterCorestrict (E₀ := E₀) ν g) := (hmap g).symm
  rw [← hf]
  exact hlc.comp f

/-- Every coefficient realization of the finite character is locally constant. -/
theorem finiteCharacterRealization_isLocallyConstant
    [TopologicalSpace G] [TopologicalSpace L] [T2Space L]
    {K : Type*} [Field K]
    (ν : G →* Lˣ) (hν : (Set.range ν).Finite) (hc : Continuous ν)
    (j : finiteCharacterCoefficientField (E₀ := E₀) ν →+* K) :
    IsLocallyConstant
      ((Units.map j.toMonoidHom).comp (finiteCharacterCorestrict (E₀ := E₀) ν)) := by
  exact (finiteCharacterCorestrict_isLocallyConstant (E₀ := E₀) ν hν hc).comp
    (Units.map j.toMonoidHom)

/-- Local constancy makes every coefficient realization continuous, with no
topology or embedding of an algebraic closure on the source number field. -/
theorem finiteCharacterRealization_continuous
    [TopologicalSpace G] [TopologicalSpace L] [T2Space L]
    {K : Type*} [Field K] [TopologicalSpace K]
    (ν : G →* Lˣ) (hν : (Set.range ν).Finite) (hc : Continuous ν)
    (j : finiteCharacterCoefficientField (E₀ := E₀) ν →+* K) :
    Continuous ((Units.map j.toMonoidHom).comp (finiteCharacterCorestrict (E₀ := E₀) ν)) :=
  (finiteCharacterRealization_isLocallyConstant (E₀ := E₀) ν hν hc j).continuous

end HilbertModularity.RepresentationTheory

namespace HilbertModularity.RepresentationTheory

variable {G E₀ L : Type*} [Group G] [Field E₀] [NumberField E₀]
  [Field L] [TopologicalSpace G] [TopologicalSpace L] [T2Space L]

/-- Starting with an explicit coefficient embedding, a continuous finite-image
local character factors through a finite number-field extension inside `L`.
The original embedding is the composite through the extension. -/
theorem exists_finiteCharacterCoefficientField_of_embedding
    (ι₀ : E₀ →+* L) (ν : G →* Lˣ)
    (hν : (Set.range ν).Finite) (hc : Continuous ν) :
    letI : Algebra E₀ L := ι₀.toAlgebra
    ∃ E : IntermediateField E₀ L,
      E.subtype.comp (algebraMap E₀ E) = ι₀ ∧
      FiniteDimensional E₀ E ∧ NumberField E ∧
      ∃ η : G →* Eˣ,
        (Set.range η).Finite ∧ IsLocallyConstant η ∧
          (Units.map E.subtype.toMonoidHom).comp η = ν := by
  let : Algebra E₀ L := ι₀.toAlgebra
  refine ⟨finiteCharacterCoefficientField (E₀ := E₀) ν, ?_, ?_, ?_,
    finiteCharacterCorestrict (E₀ := E₀) ν, ?_, ?_, ?_⟩
  · exact finiteCharacterCoefficientField_subtype_comp_algebraMap ν
  · exact finiteDimensional_finiteCharacterCoefficientField ν hν
  · exact numberField_finiteCharacterCoefficientField ν hν
  · exact finiteCharacterCorestrict_finite_range ν hν
  · exact finiteCharacterCorestrict_isLocallyConstant ν hν hc
  · exact finiteCharacterCorestrict_map ν

end HilbertModularity.RepresentationTheory
