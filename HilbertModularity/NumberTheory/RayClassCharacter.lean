module

public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.ClassGroup.Basic
public import Mathlib.Basic.Complex.Basic
public import Mathlib.Algebra.BigOperators.Finsupp.Basic
public import Mathlib.GroupTheory.OrderOfElement

/-! # Zero infinity type and finite-order Hecke characters

We use fractional ideals prime to a nonzero finite modulus, with all real places
in the infinite modulus. This allows arbitrary real-place signs. Ray-class
finiteness is the named literature input [MilneCFT, V.1, Theorem 1.7].
The zero-infinity-type deduction is the ideal-character step of the revised
manuscript's rank-one zero-weight lemma. No Galois/Hecke comparison is assumed
or proved here.
-/

public noncomputable section

open NumberField
open scoped nonZeroDivisors

namespace HilbertModularity
namespace HeckeCharacter

variable (F : Type*) [Field F] [NumberField F]

/-- Invertible fractional ideals of the ring of integers, in the given field. -/
abbrev FractionalIdeals := (FractionalIdeal (𝓞 F)⁰ F)ˣ

/-- The group generated by integral ideals coprime to the finite modulus.
This is the usual group `I(m)` of fractional ideals prime to the modulus. -/
def idealsPrimeTo (m : Ideal (𝓞 F)) : Subgroup (FractionalIdeals F) :=
  Subgroup.closure {I | ∃ J : (Ideal (𝓞 F))⁰,
    (J : Ideal (𝓞 F)) ⊔ m = ⊤ ∧ FractionalIdeal.mk0 F J = I}

/-- A unit is congruent to one modulo the finite modulus and positive at all
real places. The numerator and denominator are both coprime to the modulus;
this is the fraction description of [MilneCFT, V.1, Lemma 1.5]. -/
def rayCongruentOne (m : Ideal (𝓞 F)) (x : Fˣ) : Prop :=
  (∃ a b : 𝓞 F, a ≠ 0 ∧ b ≠ 0 ∧
    Ideal.span {a} ⊔ m = ⊤ ∧ Ideal.span {b} ⊔ m = ⊤ ∧
    a - b ∈ m ∧ (x : F) = (a : F) / (b : F)) ∧
  ∀ τ : F →+* ℝ, 0 < τ (x : F)

/-- Principal ray ideals, viewed in `I(m)`. -/
def principalRayGenerators (m : Ideal (𝓞 F)) : Set (idealsPrimeTo F m) :=
  {I | ∃ x : Fˣ, rayCongruentOne F m x ∧
    toPrincipalIdeal (𝓞 F) F x = I.val}

/-- The principal ray subgroup. Taking the subgroup generated by the displayed
principal ideals avoids building extra local valuation infrastructure. -/
def principalRaySubgroup (m : Ideal (𝓞 F)) : Subgroup (idealsPrimeTo F m) :=
  Subgroup.closure (principalRayGenerators F m)

/-- The ray class group with finite part `m` and all real places in its
infinite part, as the actual fractional-ideal quotient. -/
abbrev RayClassGroup (m : Ideal (𝓞 F)) :=
  idealsPrimeTo F m ⧸ principalRaySubgroup F m

/-- Named literature input: ray-class finiteness, [MilneCFT, V.1, Theorem 1.7,
pp.150–151]. The fractional description is justified by Lemma 1.5, p.150;
the quotient is the definition on p.149. The finite modulus must be nonzero.
No assertion about a Galois character or its weights is part of this input. -/
theorem rayClassGroup_finite (m : Ideal (𝓞 F)) (hm : m ≠ ⊥) :
    Finite (RayClassGroup F m) := by
  sorry

/-- An infinity type records an integer exponent at each complex embedding.
The principal-ideal convention below uses positive powers of these embeddings. -/
abbrev InfinityType := (F →+* ℂ) →₀ ℤ

/-- The algebraic value of an infinity type on a nonzero field element. -/
def infinityValue (k : InfinityType F) (x : Fˣ) : ℂˣ :=
  k.prod fun τ n => (Units.map τ.toMonoidHom x) ^ n

/-- An algebraic ideal Hecke character of modulus `m`. Its infinity type is
fixed as part of the data, and the principal-ray identity retains its generator.
For totally real fields this is the convention used in the rank-one lemma.
Real-place signs are permitted because only totally positive generators enter
the identity. -/
structure Algebraic (m : Ideal (𝓞 F)) where
  toMonoidHom : idealsPrimeTo F m →* ℂˣ
  infinityType : InfinityType F
  principal : ∀ (x : Fˣ), rayCongruentOne F m x →
    ∀ I : idealsPrimeTo F m, toPrincipalIdeal (𝓞 F) F x = I.val →
      toMonoidHom I = infinityValue F infinityType x

variable {F}

/-- Vanishing of every labelled exponent makes the entire principal ray
subgroup act trivially. This is the manuscript-specific zero-type deduction. -/
theorem Algebraic.principalRaySubgroup_le_ker {m : Ideal (𝓞 F)}
    (η : Algebraic F m) (hzero : ∀ τ, η.infinityType τ = 0) :
    principalRaySubgroup F m ≤ η.toMonoidHom.ker := by
  have hk : η.infinityType = 0 := Finsupp.ext hzero
  apply (Subgroup.closure_le _).2
  rintro I ⟨x, hx, hI⟩
  change η.toMonoidHom I = 1
  rw [η.principal x hx I hI, hk]
  simp [infinityValue]

/-- The ray-class character obtained by killing the zero infinity type. -/
def Algebraic.rayClassCharacter {m : Ideal (𝓞 F)}
    (η : Algebraic F m) (hzero : ∀ τ, η.infinityType τ = 0) :
    RayClassGroup F m →* ℂˣ :=
  QuotientGroup.lift _ η.toMonoidHom (η.principalRaySubgroup_le_ker hzero)

/-- The finite ray-class character recovers the given ideal character. -/
theorem Algebraic.rayClassCharacter_apply {m : Ideal (𝓞 F)}
    (η : Algebraic F m) (hzero : ∀ τ, η.infinityType τ = 0)
    (I : idealsPrimeTo F m) :
    η.rayClassCharacter hzero (QuotientGroup.mk I) = η.toMonoidHom I := by
  exact QuotientGroup.lift_mk _ _ _

/-- Zero labelled infinity exponents imply finite image, by factorization
through the actual finite ray class group. -/
theorem Algebraic.finite_range_of_zero_infinityType {m : Ideal (𝓞 F)}
    (η : Algebraic F m) (hm : m ≠ ⊥)
    (hzero : ∀ τ, η.infinityType τ = 0) :
    (Set.range η.toMonoidHom).Finite := by
  let := rayClassGroup_finite F m hm
  apply (Set.finite_range (η.rayClassCharacter hzero)).subset
  rintro _ ⟨I, rfl⟩
  exact ⟨QuotientGroup.mk I, η.rayClassCharacter_apply hzero I⟩

/-- A single positive exponent kills every value of a zero-type character;
one can use the order of its ray class group. No purity or parallel-weight
argument is needed after all labelled exponents have vanished. -/
theorem Algebraic.finite_order_of_zero_infinityType {m : Ideal (𝓞 F)}
    (η : Algebraic F m) (hm : m ≠ ⊥)
    (hzero : ∀ τ, η.infinityType τ = 0) :
    ∃ n : ℕ, 0 < n ∧ ∀ I, η.toMonoidHom I ^ n = 1 := by
  let := rayClassGroup_finite F m hm
  refine ⟨Nat.card (RayClassGroup F m), Nat.card_pos, ?_⟩
  intro I
  rw [← η.rayClassCharacter_apply hzero I, ← map_pow, pow_card_eq_one', map_one]

end HeckeCharacter
end HilbertModularity
