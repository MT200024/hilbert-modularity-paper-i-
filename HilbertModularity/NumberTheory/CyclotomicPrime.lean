module

public import HilbertModularity.NumberTheory.CyclotomicResidue
public import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal

/-! # Reduction at the ramified cyclotomic prime

For prime conductor `p`, the ideal generated by `ζ - 1` has residue field
canonically isomorphic to `ZMod p`. The resulting reduction sends `ζ` to `1`.
-/

@[expose] public section

namespace HilbertModularity.Cyclotomic

open scoped NumberField Pointwise

noncomputable section

variable (p : ℕ) [Fact p.Prime]

/-- The prime generated by `ζ - 1` in the cyclotomic integer ring. -/
def primeAboveConductor : IsDedekindDomain.HeightOneSpectrum (𝓞 (cyclotomicField p)) where
  asIdeal := Ideal.span {rootInteger p - 1}
  isPrime := IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one' p (root_isPrimitiveRoot p)
  ne_bot := Ideal.span_singleton_eq_bot.not.mpr
    (root_isPrimitiveRoot p).zeta_sub_one_prime'.ne_zero

/-- The quotient by the ramified prime has exactly `p` elements. -/
theorem card_quotient_primeAboveConductor :
    Nat.card (𝓞 (cyclotomicField p) ⧸ (primeAboveConductor p).asIdeal) = p := by
  let : IsCyclotomicExtension {p ^ (0 + 1)} ℚ (cyclotomicField p) := by
    simpa using cyclotomicField_isCyclotomicExtension p
  have hζ : IsPrimitiveRoot (root p) (p ^ (0 + 1)) := by
    simpa using root_isPrimitiveRoot p
  exact IsCyclotomicExtension.Rat.absNorm_span_zeta_sub_one p 0 hζ

/-- Reduction of cyclotomic integers to the prime field. -/
def cyclotomicReduction : 𝓞 (cyclotomicField p) →+* ZMod p :=
  let := Fintype.ofFinite (𝓞 (cyclotomicField p) ⧸ (primeAboveConductor p).asIdeal)
  (ZMod.ringEquivOfPrime _ (Fact.out : p.Prime)
    (by rw [← Nat.card_eq_fintype_card]; exact card_quotient_primeAboveConductor p)).symm.toRingHom.comp
      (Ideal.Quotient.mk (primeAboveConductor p).asIdeal)

/-- The distinguished root reduces to `1` at the ramified prime. -/
@[simp] theorem cyclotomicReduction_rootInteger : cyclotomicReduction p (rootInteger p) = 1 := by
  have h : Ideal.Quotient.mk (primeAboveConductor p).asIdeal (rootInteger p) = 1 := by
    apply sub_eq_zero.mp
    rw [← map_one (Ideal.Quotient.mk _), ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_singleton _)
  simp only [cyclotomicReduction, RingHom.comp_apply, h, map_one]

/-- Reduction is surjective onto the prime field. -/
theorem cyclotomicReduction_surjective : Function.Surjective (cyclotomicReduction p) := by
  intro x
  exact ⟨(x.val : 𝓞 (cyclotomicField p)), by simp⟩

/-- The kernel of reduction is precisely the ramified prime. -/
theorem cyclotomicReduction_eq_zero_iff (x : 𝓞 (cyclotomicField p)) :
    cyclotomicReduction p x = 0 ↔ x ∈ (primeAboveConductor p).asIdeal := by
  simp [cyclotomicReduction, Ideal.Quotient.eq_zero_iff_mem]

/-- The distinguished cyclotomic prime lies over its rational conductor. -/
instance primeAboveConductor_liesOver :
    (primeAboveConductor p).asIdeal.LiesOver (Ideal.span {(p : ℤ)}) := by
  rw [Ideal.liesOver_iff]
  refine Ideal.IsMaximal.eq_of_le (Int.ideal_span_isMaximal_of_prime p)
    Ideal.IsPrime.ne_top' ?_
  rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, algebraMap_int_eq, map_natCast]
  rw [← cyclotomicReduction_eq_zero_iff]
  simp

/-- Every cyclotomic automorphism preserves the unique prime above the conductor. -/
theorem mem_stabilizer_primeAboveConductor (σ : cyclotomicField p ≃ₐ[ℚ] cyclotomicField p) :
    σ ∈ MulAction.stabilizer (cyclotomicField p ≃ₐ[ℚ] cyclotomicField p)
      (primeAboveConductor p).asIdeal :=
  IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver' p
    (cyclotomicField p) (root_isPrimitiveRoot p) (σ • (primeAboveConductor p).asIdeal)

end

end HilbertModularity.Cyclotomic
