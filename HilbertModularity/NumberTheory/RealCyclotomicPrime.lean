module

public import HilbertModularity.NumberTheory.RealCyclotomicQuadratic
public import HilbertModularity.NumberTheory.RealCyclotomicResidue
public import HilbertModularity.NumberTheory.CyclotomicValuation
public import Mathlib.NumberTheory.NumberField.Norm
public import Mathlib.RingTheory.Norm.Transitivity

/-! # The canonical principal prime in the real cyclotomic integer ring

The actual parameter `2 - tau(1)` has norm `p`, and therefore generates the
canonical prime above the conductor. This supplies the coefficient-prime
arithmetic used by the actual RM-prime Tate lattice; see [TripathiGoswami].
-/

@[expose] public noncomputable section

open scoped NumberField

namespace HilbertModularity.Cyclotomic

variable (p : ℕ) [Fact p.Prime]

attribute [local instance] realFieldAlgebra

local instance : IsScalarTower ℚ (realCyclotomicField p) (cyclotomicField p) :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- The actual real cyclotomic parameter has rational norm equal to the conductor. -/
theorem norm_real_parameter (hp : p ≠ 2) :
    Algebra.norm ℚ (2 - tau p 1) = p := by
  rw [← norm_root_sub_one_real p hp, Algebra.norm_norm]
  exact (root_isPrimitiveRoot p).norm_sub_one_of_prime_ne_two'
    (Polynomial.cyclotomic.irreducible_rat (NeZero.pos p)) hp

/-- The canonical integral generator of the real prime. -/
def realPrimeGenerator : 𝓞 (realCyclotomicField p) := 2 - tauInteger p 1

@[simp]
theorem coe_realPrimeGenerator :
    (realPrimeGenerator p : realCyclotomicField p) = 2 - tau p 1 := rfl

/-- The integral norm of the actual real prime generator is the rational prime. -/
theorem norm_realPrimeGenerator (hp : p ≠ 2) :
    Algebra.norm ℤ (realPrimeGenerator p) = p := by
  apply Int.cast_injective (α := ℚ)
  rw [Algebra.coe_norm_int, Int.cast_natCast, coe_realPrimeGenerator, norm_real_parameter p hp]

/-- The canonical generator is nonzero. -/
theorem realPrimeGenerator_ne_zero (hp : p ≠ 2) : realPrimeGenerator p ≠ 0 := by
  intro h
  have hn := norm_realPrimeGenerator p hp
  rw [h, Algebra.norm_zero] at hn
  exact (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero) hn.symm

/-- Its principal ideal has norm equal to the rational prime. -/
theorem absNorm_span_realPrimeGenerator (hp : p ≠ 2) :
    Ideal.absNorm (Ideal.span {realPrimeGenerator p}) = p := by
  rw [Ideal.absNorm_span_singleton, norm_realPrimeGenerator p hp, Int.natAbs_natCast]

/-- The canonical generator is a prime element of the actual real integer ring. -/
theorem realPrimeGenerator_prime (hp : p ≠ 2) : Prime (realPrimeGenerator p) := by
  apply Ideal.prime_of_irreducible_absNorm_span (realPrimeGenerator_ne_zero p hp)
  rw [absNorm_span_realPrimeGenerator p hp]
  exact Nat.irreducible_iff_prime.mpr (Nat.prime_iff.mp (Fact.out : p.Prime))

/-- The actual real prime generator divides the rational conductor in the integer ring. -/
theorem realPrimeGenerator_dvd_conductor (hp : p ≠ 2) :
    realPrimeGenerator p ∣ (p : 𝓞 (realCyclotomicField p)) := by
  apply Ideal.mem_span_singleton.mp
  simpa only [absNorm_span_realPrimeGenerator p hp] using
    Ideal.absNorm_mem (Ideal.span {realPrimeGenerator p})

/-- The canonical real prime is generated by the actual parameter `2 - tau(1)`. -/
theorem span_realPrimeGenerator (hp : p ≠ 2) :
    Ideal.span {realPrimeGenerator p} = (realPrimeAboveConductor p).asIdeal := by
  let P : IsDedekindDomain.HeightOneSpectrum (𝓞 (realCyclotomicField p)) := {
    asIdeal := Ideal.span {realPrimeGenerator p}
    isPrime := (Ideal.span_singleton_prime (realPrimeGenerator_ne_zero p hp)).mpr
      (realPrimeGenerator_prime p hp)
    ne_bot := Ideal.span_singleton_eq_bot.not.mpr (realPrimeGenerator_ne_zero p hp) }
  have : P.asIdeal.IsPrime := P.isPrime
  have : P.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) := by
    rw [Ideal.liesOver_iff]
    refine Ideal.IsMaximal.eq_of_le (Int.ideal_span_isMaximal_of_prime p)
      Ideal.IsPrime.ne_top' ?_
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, algebraMap_int_eq, map_natCast]
    exact Ideal.mem_span_singleton.mpr (realPrimeGenerator_dvd_conductor p hp)
  exact congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal
    (eq_realPrimeAboveConductor_of_liesOver p P)

/-- The canonical principal coefficient prime is maximal. -/
theorem realPrimeGenerator_isMaximal (hp : p ≠ 2) :
    (Ideal.span {realPrimeGenerator p}).IsMaximal := by
  rw [span_realPrimeGenerator p hp]
  infer_instance

/-- The actual canonical parameter has normalized valuation one at the real conductor prime. -/
theorem valuation_real_parameter (hp : p ≠ 2) :
    (realPrimeAboveConductor p).valuation (realCyclotomicField p) (2 - tau p 1) =
      WithZero.exp (-1 : ℤ) := by
  change (realPrimeAboveConductor p).valuation (realCyclotomicField p)
    (algebraMap (𝓞 (realCyclotomicField p)) (realCyclotomicField p) (realPrimeGenerator p)) = _
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  exact (realPrimeAboveConductor p).intValuation_singleton
    (realPrimeGenerator_ne_zero p hp) (span_realPrimeGenerator p hp).symm

/-- The actual real cyclotomic coefficient field has the expected half degree. -/
theorem finrank_realCyclotomicField (hp : p ≠ 2) :
    Module.finrank ℚ (realCyclotomicField p) = (p - 1) / 2 := by
  have h := Module.finrank_mul_finrank ℚ (realCyclotomicField p) (cyclotomicField p)
  rw [finrank_real_cyclotomic p hp,
    IsCyclotomicExtension.finrank (cyclotomicField p)
      (Polynomial.cyclotomic.irreducible_rat (NeZero.pos p)),
    Nat.totient_prime (Fact.out : p.Prime)] at h
  omega

/-- The actual conductor has the normalized multiplicative valuation prescribed by total ramification. -/
theorem intValuation_real_conductor (hp : p ≠ 2) :
    (realPrimeAboveConductor p).intValuation (p : 𝓞 (realCyclotomicField p)) =
      WithZero.exp (-(((p - 1) / 2 : ℕ) : ℤ)) := by
  have h := congrArg WithZero.exp
    (log_valuation_real_conductor p hp (valuation_real_parameter p hp))
  rw [WithZero.exp_log ((Valuation.ne_zero_iff _).mpr
    (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero))] at h
  simpa only [← map_natCast (algebraMap (𝓞 (realCyclotomicField p)) (realCyclotomicField p)),
    IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap] using h

/-- The canonical principal real prime is totally ramified with exponent `(p-1)/2`. -/
theorem span_realPrimeGenerator_pow (hp : p ≠ 2) :
    (Ideal.span {realPrimeGenerator p}) ^ ((p - 1) / 2) =
      Ideal.span {(p : 𝓞 (realCyclotomicField p))} := by
  let P := realPrimeAboveConductor p
  let d := (p - 1) / 2
  have hle : Ideal.span {(p : 𝓞 (realCyclotomicField p))} ≤ P.asIdeal ^ d := by
    rw [Ideal.span_singleton_le_iff_mem, ← P.intValuation_le_pow_iff_mem]
    exact (intValuation_real_conductor p hp).le
  have hn : Ideal.absNorm (P.asIdeal ^ d) =
      Ideal.absNorm (Ideal.span {(p : 𝓞 (realCyclotomicField p))}) := by
    change Ideal.absNorm ((realPrimeAboveConductor p).asIdeal ^ d) = _
    rw [map_pow, ← span_realPrimeGenerator p hp, absNorm_span_realPrimeGenerator p hp,
      Ideal.absNorm_span_natCast, NumberField.RingOfIntegers.rank, finrank_realCyclotomicField p hp]
  obtain ⟨I, hI⟩ := Ideal.dvd_iff_le.mpr hle
  have hmul := congrArg Ideal.absNorm hI
  rw [map_mul, ← hn] at hmul
  have hpos : 0 < Ideal.absNorm (P.asIdeal ^ d) := by
    change 0 < Ideal.absNorm ((realPrimeAboveConductor p).asIdeal ^ d)
    rw [map_pow, ← span_realPrimeGenerator p hp, absNorm_span_realPrimeGenerator p hp]
    exact pow_pos (Fact.out : p.Prime).pos _
  have hi : Ideal.absNorm I = 1 := by nlinarith
  have htop := Ideal.absNorm_eq_one_iff.mp hi
  rw [htop, ← Ideal.one_eq_top, mul_one] at hI
  rw [span_realPrimeGenerator p hp]
  exact hI.symm

/-- The canonical coefficient-prime residue field is the rational prime field. -/
def realPrimeResidueEquiv (hp : p ≠ 2) :
    (𝓞 (realCyclotomicField p) ⧸ Ideal.span {realPrimeGenerator p}) ≃+* ZMod p :=
  (Ideal.quotEquivOfEq (span_realPrimeGenerator p hp)).trans (realCyclotomicResidueEquiv p)

/-- The integral cofactor `p / (2 - tau(1))` in the actual real integer ring. -/
def realPrimeCofactor (hp : p ≠ 2) : 𝓞 (realCyclotomicField p) :=
  (realPrimeGenerator_dvd_conductor p hp).choose

/-- The canonical generator and cofactor multiply to the rational conductor. -/
theorem realPrimeGenerator_mul_cofactor (hp : p ≠ 2) :
    realPrimeGenerator p * realPrimeCofactor p hp = p :=
  (realPrimeGenerator_dvd_conductor p hp).choose_spec.symm

/-- The ramification exponent at an odd real cyclotomic conductor is positive. -/
theorem realPrimeRamification_pos (hp : p ≠ 2) : 0 < (p - 1) / 2 := by
  have := (Fact.out : p.Prime).two_le
  omega

end HilbertModularity.Cyclotomic
