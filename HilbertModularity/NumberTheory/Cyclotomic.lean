module

public import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.RootsOfUnity.Complex
public import HilbertModularity.Polynomial.Chebyshev

@[expose] public section

/-! # Cyclotomic fields and their trace parameters

All fields are constructed in the same algebraic closure of the rationals.
-/

namespace HilbertModularity.Cyclotomic

open Polynomial IntermediateField

noncomputable section

/-- A fixed algebraic closure for the cyclotomic fields and their coefficients. -/
abbrev Qbar := AlgebraicClosure ℚ

/-- Existence of a primitive root in the fixed algebraic closure. -/
theorem exists_primitiveRoot (N : ℕ) [NeZero N] : ∃ z : Qbar, IsPrimitiveRoot z N := by
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (cyclotomic N Qbar)
    (degree_cyclotomic_pos N Qbar (NeZero.pos N)).ne.symm
  exact ⟨z, isRoot_cyclotomic_iff.mp hz⟩

/-- The fixed primitive root used throughout the constructions. -/
def zeta (N : ℕ) [NeZero N] : Qbar := (exists_primitiveRoot N).choose

theorem zeta_isPrimitiveRoot (N : ℕ) [NeZero N] : IsPrimitiveRoot (zeta N) N :=
  (exists_primitiveRoot N).choose_spec

/-- The cyclotomic field as an actual subfield of the fixed algebraic closure. -/
def cyclotomicField (N : ℕ) [NeZero N] : IntermediateField ℚ Qbar :=
  IntermediateField.adjoin ℚ {zeta N}

/-- The real cyclotomic field generated by the first trace parameter. -/
def realCyclotomicField (N : ℕ) [NeZero N] : IntermediateField ℚ Qbar :=
  IntermediateField.adjoin ℚ {zeta N + (zeta N)⁻¹}

instance cyclotomicField_isCyclotomicExtension (N : ℕ) [NeZero N] :
    IsCyclotomicExtension {N} ℚ (cyclotomicField N) :=
  (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
    (n := N) (K := ℚ) (L := Qbar) (cyclotomicField N) (zeta_isPrimitiveRoot N)).mpr rfl

instance cyclotomicField_numberField (N : ℕ) [NeZero N] :
    NumberField (cyclotomicField N) where
  to_finiteDimensional := IntermediateField.adjoin.finiteDimensional
    (Algebra.IsIntegral.isIntegral (R := ℚ) (zeta N))

instance realCyclotomicField_numberField (N : ℕ) [NeZero N] :
    NumberField (realCyclotomicField N) where
  to_finiteDimensional := IntermediateField.adjoin.finiteDimensional
    (Algebra.IsIntegral.isIntegral (R := ℚ) (zeta N + (zeta N)⁻¹))

theorem zeta_mem (N : ℕ) [NeZero N] : zeta N ∈ cyclotomicField N :=
  IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)

theorem realCyclotomicField_le (N : ℕ) [NeZero N] :
    realCyclotomicField N ≤ cyclotomicField N := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro x rfl
  exact (cyclotomicField N).add_mem (zeta_mem N)
    ((cyclotomicField N).inv_mem (zeta_mem N))

/-- Every trace of a power is in the real cyclotomic field, by the integral
Chebyshev recurrence; this does not require the power to be primitive. -/
theorem tracePower_mem (N m : ℕ) [NeZero N] :
    (zeta N) ^ m + (zeta N)⁻¹ ^ m ∈ realCyclotomicField N := by
  have hz := (zeta_isPrimitiveRoot N).ne_zero (NeZero.ne N)
  rw [← Polynomial.Chebyshev.C_eval_add_inv m (zeta N) hz]
  let t : realCyclotomicField N :=
    ⟨zeta N + (zeta N)⁻¹, IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)⟩
  have h := Polynomial.Chebyshev.algebraMap_eval_C
    (R := realCyclotomicField N) (R' := Qbar) t (m : ℤ)
  change (Polynomial.Chebyshev.C Qbar (m : ℤ)).eval
    ((algebraMap (realCyclotomicField N) Qbar) t) ∈ realCyclotomicField N
  rw [← h]
  exact ((Polynomial.Chebyshev.C (realCyclotomicField N) m).eval t).property

/-- The trace parameter as an element of the real cyclotomic field. -/
def tau (N m : ℕ) [NeZero N] : realCyclotomicField N :=
  ⟨(zeta N) ^ m + (zeta N)⁻¹ ^ m, tracePower_mem N m⟩

@[simp] theorem coe_tau (N m : ℕ) [NeZero N] :
    (tau N m : Qbar) = (zeta N) ^ m + (zeta N)⁻¹ ^ m := rfl

/-- The trace parameters are algebraic integers. -/
theorem tau_isIntegral (N m : ℕ) [NeZero N] : IsIntegral ℤ (tau N m) := by
  apply (isIntegral_algHom_iff ((realCyclotomicField N).val.restrictScalars ℤ)
    (realCyclotomicField N).val.injective).mp
  exact (((zeta_isPrimitiveRoot N).isIntegral (NeZero.pos N)).pow m).add
    (((zeta_isPrimitiveRoot N).inv.isIntegral (NeZero.pos N)).pow m)

/-- The trace parameter in the integer ring of the real cyclotomic field. -/
def tauInteger (N m : ℕ) [NeZero N] : NumberField.RingOfIntegers (realCyclotomicField N) :=
  ⟨tau N m, tau_isIntegral N m⟩

@[simp] theorem coe_tauInteger (N m : ℕ) [NeZero N] :
    (tauInteger N m : realCyclotomicField N) = tau N m := rfl

/-- The chosen root, regarded as an element of its cyclotomic field. -/
def root (N : ℕ) [NeZero N] : cyclotomicField N := ⟨zeta N, zeta_mem N⟩

theorem root_isPrimitiveRoot (N : ℕ) [NeZero N] : IsPrimitiveRoot (root N) N :=
  (zeta_isPrimitiveRoot N).of_map_of_injective
    (f := (cyclotomicField N).val) (cyclotomicField N).val.injective

/-- The automorphism carrying the chosen primitive root to another primitive root. -/
def rootEquiv (N : ℕ) [NeZero N] (w : cyclotomicField N) (hw : IsPrimitiveRoot w N) :
    cyclotomicField N ≃ₐ[ℚ] cyclotomicField N :=
  ((root_isPrimitiveRoot N).powerBasis ℚ).equivOfMinpoly (hw.powerBasis ℚ) (by
    simp only [IsPrimitiveRoot.powerBasis_gen]
    exact ((root_isPrimitiveRoot N).minpoly_eq_cyclotomic_of_irreducible
      (cyclotomic.irreducible_rat (NeZero.pos N))).symm.trans
      (hw.minpoly_eq_cyclotomic_of_irreducible (cyclotomic.irreducible_rat (NeZero.pos N))))

@[simp] theorem rootEquiv_root (N : ℕ) [NeZero N] (w : cyclotomicField N)
    (hw : IsPrimitiveRoot w N) : rootEquiv N w hw (root N) = w := by
  exact PowerBasis.equivOfMinpoly_gen _ _ _

/-- Algebraic complex conjugation, characterized by inversion of the primitive root. -/
def conjugation (N : ℕ) [NeZero N] : cyclotomicField N ≃ₐ[ℚ] cyclotomicField N :=
  rootEquiv N (root N)⁻¹ (root_isPrimitiveRoot N).inv

@[simp] theorem conjugation_root (N : ℕ) [NeZero N] :
    conjugation N (root N) = (root N)⁻¹ := rootEquiv_root _ _ _

/-- Conjugation fixes the trace-generated subfield. -/
theorem conjugation_inclusion (N : ℕ) [NeZero N] (x : realCyclotomicField N) :
    conjugation N (IntermediateField.inclusion (realCyclotomicField_le N) x) =
      IntermediateField.inclusion (realCyclotomicField_le N) x := by
  let i := IntermediateField.inclusion (realCyclotomicField_le N)
  have h : (conjugation N).toAlgHom.comp i = i := by
    apply IntermediateField.adjoin_algHom_ext ℚ
    rintro y rfl
    change conjugation N (root N + (root N)⁻¹) = root N + (root N)⁻¹
    rw [map_add, map_inv₀, conjugation_root, inv_inv, add_comm]
  exact AlgHom.congr_fun h x

/-- The sum of an element and its conjugate belongs to the trace-generated subfield. -/
theorem add_conjugation_mem (N : ℕ) [NeZero N] (x : cyclotomicField N) :
    ((x + conjugation N x : cyclotomicField N) : Qbar) ∈ realCyclotomicField N := by
  let b := (root_isPrimitiveRoot N).powerBasis ℚ
  change (cyclotomicField N).val (x + conjugation N x) ∈ realCyclotomicField N
  rw [← b.basis.sum_repr x]
  simp only [map_sum, map_add, Algebra.smul_def, map_mul, b, PowerBasis.basis_eq_pow,
    IsPrimitiveRoot.powerBasis_gen, map_pow, conjugation_root, AlgEquiv.commutes,
    map_inv₀]
  change (∑ i, (b.basis.repr x i : Qbar) * (zeta N) ^ (i : ℕ)) +
    (∑ i, (b.basis.repr x i : Qbar) * (zeta N)⁻¹ ^ (i : ℕ)) ∈ realCyclotomicField N
  rw [← Finset.sum_add_distrib]
  apply (realCyclotomicField N).sum_mem
  intro i _
  rw [← mul_add]
  exact (realCyclotomicField N).mul_mem
    ((realCyclotomicField N).algebraMap_mem _) (tracePower_mem N i)

/-- The trace-generated field is exactly the fixed field of conjugation. -/
theorem conjugation_eq_self_iff (N : ℕ) [NeZero N] (x : cyclotomicField N) :
    conjugation N x = x ↔ (x : Qbar) ∈ realCyclotomicField N := by
  constructor
  · intro hx
    have h := add_conjugation_mem N x
    rw [hx] at h
    have h2 : (2 : Qbar) ∈ realCyclotomicField N := (realCyclotomicField N).natCast_mem 2
    have hdiv := (realCyclotomicField N).div_mem h h2
    change ((x : Qbar) + (x : Qbar)) / 2 ∈ realCyclotomicField N at hdiv
    convert hdiv using 1; ring
  · intro hx
    exact conjugation_inclusion N ⟨x, hx⟩

/-- The algebraic involution agrees with complex conjugation under every complex embedding. -/
theorem embedding_conjugation (N : ℕ) [NeZero N]
    (e : cyclotomicField N →ₐ[ℚ] ℂ) (x : cyclotomicField N) :
    e (conjugation N x) = star (e x) := by
  have h : e.comp (conjugation N).toAlgHom =
      (Complex.conjAe.restrictScalars ℚ).toAlgHom.comp e := by
    apply ((root_isPrimitiveRoot N).powerBasis ℚ).algHom_ext
    change e (conjugation N (root N)) = star (e (root N))
    rw [conjugation_root, map_inv₀]
    have hn := ((root_isPrimitiveRoot N).map_of_injective e.injective).norm'_eq_one
      (NeZero.ne N)
    change ‖e (root N)‖ = 1 at hn
    simp [Complex.inv_def, Complex.normSq_eq_norm_sq, hn]
  exact AlgHom.congr_fun h x

end

end HilbertModularity.Cyclotomic
