module

public import HilbertModularity.NumberTheory.CyclotomicPrime

/-! # The unique prime at a prime-power cyclotomic conductor

The cyclotomic prime generated by `zeta - 1` restricts to the unique prime above
`p` in the real cyclotomic field of conductor `p^(k+1)`.
-/

@[expose] public noncomputable section

open scoped NumberField

namespace HilbertModularity.Cyclotomic

variable (p k : ℕ) [Fact p.Prime]

/-- The ramified prime of the full prime-power cyclotomic field. -/
def primeAbovePrimePower :
    IsDedekindDomain.HeightOneSpectrum (𝓞 (cyclotomicField (p ^ (k + 1)))) where
  asIdeal := Ideal.span {rootInteger (p ^ (k + 1)) - 1}
  isPrime := IsCyclotomicExtension.Rat.isPrime_span_zeta_sub_one p k
    (root_isPrimitiveRoot (p ^ (k + 1)))
  ne_bot := IsCyclotomicExtension.Rat.span_zeta_sub_one_ne_bot p k
    (root_isPrimitiveRoot (p ^ (k + 1)))

instance primeAbovePrimePower_liesOver :
    (primeAbovePrimePower p k).asIdeal.LiesOver (Ideal.span {(p : ℤ)}) :=
  IsCyclotomicExtension.Rat.liesOver_span_zeta_sub_one p k
    (root_isPrimitiveRoot (p ^ (k + 1)))

/-- Restriction of the ramified prime to the real cyclotomic integer ring. -/
def realPrimeAbovePrimePower :
    IsDedekindDomain.HeightOneSpectrum (𝓞 (realCyclotomicField (p ^ (k + 1)))) := by
  letI : Algebra (realCyclotomicField (p ^ (k + 1))) (cyclotomicField (p ^ (k + 1))) :=
    (IntermediateField.inclusion (realCyclotomicField_le (p ^ (k + 1)))).toRingHom.toAlgebra
  exact (primeAbovePrimePower p k).under (𝓞 (realCyclotomicField (p ^ (k + 1))))

/-- The restricted real prime lies over the rational prime `p`. -/
instance realPrimeAbovePrimePower_liesOver :
    (realPrimeAbovePrimePower p k).asIdeal.LiesOver (Ideal.span {(p : ℤ)}) := by
  let : Algebra (realCyclotomicField (p ^ (k + 1))) (cyclotomicField (p ^ (k + 1))) :=
    (IntermediateField.inclusion (realCyclotomicField_le (p ^ (k + 1)))).toRingHom.toAlgebra
  change ((primeAbovePrimePower p k).asIdeal.under
    (𝓞 (realCyclotomicField (p ^ (k + 1))))).LiesOver (Ideal.span {(p : ℤ)})
  exact Ideal.LiesOver.tower_bot (primeAbovePrimePower p k).asIdeal _ _

/-- The real prime above a prime-power conductor is unique. -/
theorem eq_realPrimeAbovePrimePower_of_liesOver
    (P : IsDedekindDomain.HeightOneSpectrum (𝓞 (realCyclotomicField (p ^ (k + 1)))))
    [P.asIdeal.LiesOver (Ideal.span {(p : ℤ)})] : P = realPrimeAbovePrimePower p k := by
  let : Algebra (realCyclotomicField (p ^ (k + 1))) (cyclotomicField (p ^ (k + 1))) :=
    (IntermediateField.inclusion (realCyclotomicField_le (p ^ (k + 1)))).toRingHom.toAlgebra
  obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral
    (S := 𝓞 (cyclotomicField (p ^ (k + 1)))) P.asIdeal
  have : Q.IsMaximal := hQ
  have : Q.LiesOver P.asIdeal := hQP
  have : Q.LiesOver (Ideal.span {(p : ℤ)}) := Ideal.LiesOver.trans Q P.asIdeal _
  have he : Q = (primeAbovePrimePower p k).asIdeal :=
    IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver p k
      (cyclotomicField (p ^ (k + 1))) (root_isPrimitiveRoot (p ^ (k + 1))) Q
  apply IsDedekindDomain.HeightOneSpectrum.ext
  rw [Q.over_def P.asIdeal, he]
  rfl

end HilbertModularity.Cyclotomic
