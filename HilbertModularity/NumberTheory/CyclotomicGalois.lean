module

public import HilbertModularity.NumberTheory.CyclotomicCharacter
public import HilbertModularity.NumberTheory.CyclotomicEmbeddings
public import Mathlib.FieldTheory.Galois.Infinite
public import Mathlib.RingTheory.RootsOfUnity.Complex
public import Mathlib.Tactic.LinearCombination

/-! # Fixed fields of cyclotomic characters

The kernel of the character on roots of unity fixes precisely the field they
generate. We specialize this to the real and full cyclotomic fields in the fixed
algebraic closure, as in [TripathiGoswami, prime-level residual characters].
-/

@[expose] public noncomputable section

namespace IsPrimitiveRoot

variable {K E : Type*} [Field K] [Field E] [Algebra K E]
  {N : ℕ} [NeZero N] [Fact (1 < N)] {ζ : E} (hζ : IsPrimitiveRoot ζ N)

/-- The cyclotomic character is trivial precisely when the primitive root is fixed. -/
theorem autToPow_eq_one_iff (g : E ≃ₐ[K] E) :
    hζ.autToPow K g = 1 ↔ g ζ = ζ := by
  constructor
  · intro h
    rw [← hζ.autToPow_spec K g, h]
    simp [ZMod.val_one]
  · intro h
    apply Units.ext
    apply ZMod.val_injective
    apply hζ.pow_inj (ZMod.val_lt _) (ZMod.val_lt _)
    rw [hζ.autToPow_spec K g, h]
    simp [ZMod.val_one]

/-- The kernel of the character on roots of unity is the fixing subgroup of
the field generated by a primitive root. -/
theorem ker_autToPow :
    (hζ.autToPow K).ker = (IntermediateField.adjoin K {ζ}).fixingSubgroup := by
  ext g
  rw [MonoidHom.mem_ker, hζ.autToPow_eq_one_iff, IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h
    have he : g.toAlgHom.comp (IntermediateField.adjoin K {ζ}).val =
        (IntermediateField.adjoin K {ζ}).val := by
      apply IntermediateField.adjoin_algHom_ext K
      rintro x rfl
      exact h
    intro x hx
    exact AlgHom.congr_fun he ⟨x, hx⟩
  · intro h
    exact h ζ (IntermediateField.subset_adjoin K _ rfl)

/-- Infinite Galois correspondence identifies the fixed field of the cyclotomic kernel. -/
theorem fixedField_ker_autToPow [IsGalois K E] :
    IntermediateField.fixedField (hζ.autToPow K).ker = IntermediateField.adjoin K {ζ} := by
  rw [hζ.ker_autToPow, InfiniteGalois.fixedField_fixingSubgroup]

end IsPrimitiveRoot

namespace HilbertModularity.Cyclotomic

/-- The finite cyclotomic character on the absolute Galois group of the real
cyclotomic field, realized in the fixed algebraic closure. At prime conductor
this is the residual cyclotomic character. -/
def residualCharacter (N : ℕ) [NeZero N] :
    (Qbar ≃ₐ[realCyclotomicField N] Qbar) →* (ZMod N)ˣ :=
  (zeta_isPrimitiveRoot N).autToPow (realCyclotomicField N)

/-- This character is mathlib's modular cyclotomic character, restricted to
automorphisms over the real cyclotomic field. -/
theorem residualCharacter_eq_modularCyclotomicCharacter (N : ℕ) [NeZero N]
    (g : Qbar ≃ₐ[realCyclotomicField N] Qbar) :
    residualCharacter N g =
      modularCyclotomicCharacter Qbar (zeta_isPrimitiveRoot N).card_rootsOfUnity g.toRingEquiv :=
  (zeta_isPrimitiveRoot N).autToPow_eq_modularCyclotomicCharacter N
    (realCyclotomicField N) g

/-- At prime conductor the finite character is the reduction of the integral
cyclotomic character, so its kernel is the manuscript's residual kernel. -/
theorem residualCharacter_eq_reduction (p : ℕ) [Fact p.Prime]
    (g : Qbar ≃ₐ[realCyclotomicField p] Qbar) :
    (residualCharacter p g : ZMod p) =
      (_root_.cyclotomicCharacter Qbar p g.toRingEquiv : ℤ_[p]).toZMod := by
  rw [residualCharacter_eq_modularCyclotomicCharacter,
    cyclotomicCharacter.toZMod p (zeta_isPrimitiveRoot p).card_rootsOfUnity]

/-- The residual cyclotomic kernel fixes the full cyclotomic field, viewed
in the same algebraic closure as the real base field. -/
theorem fixedField_ker_residualCharacter (N : ℕ) [NeZero N] [Fact (1 < N)] :
    (IntermediateField.fixedField (residualCharacter N).ker).restrictScalars ℚ =
      cyclotomicField N := by
  rw [residualCharacter, (zeta_isPrimitiveRoot N).fixedField_ker_autToPow,
    IntermediateField.restrictScalars_adjoin_eq_sup]
  exact sup_eq_right.mpr (realCyclotomicField_le N)

/-- An automorphism over the real cyclotomic field sends the root to itself
or to its inverse, the two roots of its quadratic trace polynomial. -/
theorem zeta_action_eq_or_inv (N : ℕ) [NeZero N]
    (g : Qbar ≃ₐ[realCyclotomicField N] Qbar) :
    g (zeta N) = zeta N ∨ g (zeta N) = (zeta N)⁻¹ := by
  have ht := g.commutes
    (⟨zeta N + (zeta N)⁻¹, IntermediateField.subset_adjoin ℚ _ rfl⟩ : realCyclotomicField N)
  have hs : g (zeta N) + (g (zeta N))⁻¹ = zeta N + (zeta N)⁻¹ := by
    change g (zeta N + (zeta N)⁻¹) = zeta N + (zeta N)⁻¹ at ht
    simpa only [map_add, map_inv₀] using ht
  have hz := (zeta_isPrimitiveRoot N).ne_zero (NeZero.ne N)
  have hp := congrArg (fun x => x * g (zeta N)) hs
  rw [add_mul, inv_mul_cancel₀ ((map_ne_zero g).mpr hz)] at hp
  have hprod : (g (zeta N) - zeta N) * (g (zeta N) - (zeta N)⁻¹) = 0 := by
    linear_combination hp + mul_inv_cancel₀ hz
  simpa only [sub_eq_zero] using mul_eq_zero.mp hprod

/-- The residual character over the real cyclotomic field takes only sign values. -/
theorem residualCharacter_eq_one_or_neg_one (N : ℕ) [NeZero N] [Fact (1 < N)]
    (g : Qbar ≃ₐ[realCyclotomicField N] Qbar) :
    residualCharacter N g = 1 ∨ residualCharacter N g = -1 := by
  rcases zeta_action_eq_or_inv N g with h | h
  · exact Or.inl (((zeta_isPrimitiveRoot N).autToPow_eq_one_iff g).mpr h)
  · exact Or.inr ((zeta_isPrimitiveRoot N).autToPow_eq_neg_one_of_apply_eq_inv g h)

/-- The residual character over the real cyclotomic field has square one. -/
theorem residualCharacter_sq (N : ℕ) [NeZero N] [Fact (1 < N)] :
    residualCharacter N ^ 2 = 1 := by
  ext g
  rcases residualCharacter_eq_one_or_neg_one N g with h | h <;> simp [h]

/-- Every complex conjugation has residual cyclotomic character minus one.
The embedding and its compatibility with conjugation specify the real place. -/
theorem residualCharacter_complexConjugation (N : ℕ) [NeZero N]
    (ι : Qbar →+* ℂ) (c : Qbar ≃ₐ[realCyclotomicField N] Qbar)
    (hc : ∀ x, ι (c x) = star (ι x)) : residualCharacter N c = -1 := by
  apply (zeta_isPrimitiveRoot N).autToPow_eq_neg_one_of_apply_eq_inv
  apply ι.injective
  rw [hc, map_inv₀]
  exact (Complex.inv_eq_conj
    (((zeta_isPrimitiveRoot N).map_of_injective ι.injective).norm'_eq_one (NeZero.ne N))).symm

end HilbertModularity.Cyclotomic
