/-! # The abelian quotient unramified at finite places

The universal quotient, independent of any character, is the narrow class
field quotient. All real places are allowed to ramify. Global class field
theory identifies it with the ray class group of finite modulus `(1)`.
-/

public noncomputable section

open NumberField IsDedekindDomain
open scoped BigOperators

namespace HilbertModularity

variable (F : Type*) [Field F] [NumberField F]

/-- Elements in inertia at a finite prime of the algebraic closure. No real
inertia is included, so the associated class group is the narrow one. -/
def finiteInertiaElements : Set (HilbertModularForms.AbsoluteGalois F) :=
  {g | ∃ (P : Ideal (𝓞 F)) (Q : Ideal (𝓞 (AlgebraicClosure F))),
    P.IsMaximal ∧ Q.IsMaximal ∧ Q.LiesOver P ∧
      g ∈ Q.inertia (HilbertModularForms.AbsoluteGalois F)}

/-- The closed normal subgroup generated by commutators and all finite
inertia groups in the actual absolute Galois group. -/
def unramifiedAbelianKernel : Subgroup (HilbertModularForms.AbsoluteGalois F) :=
  (Subgroup.normalClosure
    ((commutator (HilbertModularForms.AbsoluteGalois F) : Set _) ∪
      finiteInertiaElements F)).topologicalClosure

instance : (unramifiedAbelianKernel F).Normal :=
  Subgroup.is_normal_topologicalClosure _

/-- The maximal abelian Galois quotient unramified at all finite places. -/
abbrev UnramifiedAbelianQuotient :=
  HilbertModularForms.AbsoluteGalois F ⧸ unramifiedAbelianKernel F

/-- Narrow class field reciprocity, [MilneCFT, V Theorems 3.5–3.6 and
Remark 3.8, p.158; V Example 1.8(b), p.151]. The finite part of the modulus
is the unit ideal and its infinite part contains every real place.

Every finite abelian extension unramified at finite primes has conductor
dividing this modulus. The reciprocity and existence theorems identify their
maximal compositum with this ray class field. The closed normal subgroup
description follows from Galois correspondence [MilneFT, Theorem 7.13].
Only existence of the group isomorphism is used; no Frobenius convention is
chosen by this interface. It contains no particular character or weight
hypothesis, and asserts no manuscript comparison or modularity result. -/
theorem nonempty_narrowClassFieldEquiv :
    Nonempty (HeckeCharacter.RayClassGroup F ⊤ ≃* UnramifiedAbelianQuotient F) := by
  sorry

/-- Ray-class finiteness makes the universal unramified abelian quotient
finite. Both class field reciprocity and ray-class finiteness remain named
literature premises. -/
theorem unramifiedAbelianQuotient_finite : Finite (UnramifiedAbelianQuotient F) := by
  let := HeckeCharacter.rayClassGroup_finite F ⊤ top_ne_bot
  exact Finite.of_equiv _ (nonempty_narrowClassFieldEquiv F).some.toEquiv

variable {F} {A : Type*} [CommGroup A] [TopologicalSpace A] [T2Space A]

omit [NumberField F] in
/-- A continuous abelian character trivial on finite inertia kills the
closed normal subgroup defining the unramified quotient. -/
theorem unramifiedAbelianKernel_le_ker
    (χ : HilbertModularForms.AbsoluteGalois F →* A) (hc : Continuous χ)
    (hi : ∀ g ∈ finiteInertiaElements F, χ g = 1) :
    unramifiedAbelianKernel F ≤ χ.ker := by
  apply Subgroup.topologicalClosure_minimal
  · apply Subgroup.normalClosure_le_normal
    rintro g (hg | hg)
    · exact Abelianization.commutator_subset_ker χ hg
    · exact hi g hg
  · exact isClosed_singleton.preimage hc

/-- The actual descended character on the universal unramified quotient. -/
def unramifiedAbelianCharacter
    (χ : HilbertModularForms.AbsoluteGalois F →* A) (hc : Continuous χ)
    (hi : ∀ g ∈ finiteInertiaElements F, χ g = 1) :
    UnramifiedAbelianQuotient F →* A :=
  QuotientGroup.lift _ χ (unramifiedAbelianKernel_le_ker χ hc hi)

/-- One positive exponent kills an abelian character unramified at every finite place.
Real signs are allowed throughout. -/
theorem finite_order_of_unramified_character
    (χ : HilbertModularForms.AbsoluteGalois F →* A) (hc : Continuous χ)
    (hi : ∀ g ∈ finiteInertiaElements F, χ g = 1) :
    ∃ n : ℕ, 0 < n ∧ ∀ g, χ g ^ n = 1 := by
  let := unramifiedAbelianQuotient_finite F
  let η := unramifiedAbelianCharacter χ hc hi
  refine ⟨Nat.card (UnramifiedAbelianQuotient F), Nat.card_pos, fun g => ?_⟩
  change η (QuotientGroup.mk g) ^ Nat.card (UnramifiedAbelianQuotient F) = 1
  rw [← map_pow, pow_card_eq_one', map_one]

/-- A finitely ramified character with bounded inertia exponents has finite
order. The bound at each prime must hold for every prime above it; no implicit
choice or conjugacy of primes of the algebraic closure is used. -/
theorem finite_order_of_inertia_exponents [IsTopologicalGroup A]
    (χ : HilbertModularForms.AbsoluteGalois F →* A) (hc : Continuous χ)
    (bad : Finset (HeightOneSpectrum (𝓞 F)))
    (n : HeightOneSpectrum (𝓞 F) → ℕ) (hn : ∀ q ∈ bad, 0 < n q)
    (hi : ∀ (q : HeightOneSpectrum (𝓞 F))
      (Q : Ideal (𝓞 (AlgebraicClosure F))),
      Q.IsMaximal → Q.LiesOver q.asIdeal →
      ∀ g : HilbertModularForms.AbsoluteGalois F,
        g ∈ Q.inertia (HilbertModularForms.AbsoluteGalois F) →
        (q ∈ bad → χ g ^ n q = 1) ∧ (q ∉ bad → χ g = 1)) :
    ∃ m : ℕ, 0 < m ∧ ∀ g, χ g ^ m = 1 := by
  classical
  let N := ∏ q ∈ bad, n q
  have hN : 0 < N := Finset.prod_pos hn
  have hpow : ∀ g ∈ finiteInertiaElements F, (χ ^ N) g = 1 := by
    rintro g ⟨P, Q, hP, hQ, hQP, hg⟩
    let q : HeightOneSpectrum (𝓞 F) :=
      ⟨P, hP.isPrime,
        Ring.ne_bot_of_isMaximal_of_not_isField hP (RingOfIntegers.not_isField F)⟩
    have hiq := hi q Q hQ hQP g hg
    change χ g ^ N = 1
    by_cases hq : q ∈ bad
    · have heq : χ g ^ n q = 1 := hiq.1 hq
      obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem n hq
      change N = n q * k at hk
      rw [hk, pow_mul, heq, one_pow]
    · have heq : χ g = 1 := hiq.2 hq
      rw [heq, one_pow]
  obtain ⟨m, hm, hχ⟩ := finite_order_of_unramified_character (χ ^ N) (hc.pow N) hpow
  refine ⟨N * m, Nat.mul_pos hN hm, fun g => ?_⟩
  simpa only [MonoidHom.pow_apply, pow_mul] using hχ g

/-- A field has only finitely many roots of a fixed positive power, so a
uniform finite-order bound on a field-valued character gives finite image. -/
theorem finite_range_of_character_exponent {G L : Type*} [Group G] [Field L]
    (χ : G →* Lˣ) {n : ℕ} (hn : 0 < n) (hχ : ∀ g, χ g ^ n = 1) :
    (Set.range χ).Finite := by
  let : NeZero n := ⟨Nat.ne_of_gt hn⟩
  have hfin := Set.finite_range (fun u : rootsOfUnity n L => (u : Lˣ))
  apply hfin.subset
  rintro x ⟨g, rfl⟩
  exact ⟨⟨χ g, (mem_rootsOfUnity n (χ g)).mpr (hχ g)⟩, rfl⟩

end HilbertModularity
