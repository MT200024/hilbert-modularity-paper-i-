module
public import HilbertModularity.PaperI.QuotientCoordinates
public import HilbertModularity.Hypergeometric.GaloisRealizationQuadraticDegree

/-! # The full invariant field of either quotient -/
public noncomputable section
namespace HilbertModularity.PaperI
variable {K F : Type*} [Field K] [Field F] [Algebra K F]

def reflectionFixedField (j : F ≃ₐ[K] F) : IntermediateField K F where
  carrier := {x | j x = x}
  zero_mem' := map_zero _
  add_mem' := fun hx hy => (map_add _ _ _).trans (congrArg₂ (·+·) hx hy)
  one_mem' := map_one _
  mul_mem' := fun hx hy => (map_mul _ _ _).trans (congrArg₂ (·*·) hx hy)
  inv_mem' := fun _ hx => (map_inv₀ _ _).trans (congrArg Inv.inv hx)
  algebraMap_mem' := j.commutes

/-- The coordinates X and Z generate the fixed field. The hypotheses
specify a function field generated by u and Y with the indicated reflection. -/
theorem signed_fixed_field (k : ℕ) (u y : F) (s : K) (j : F ≃ₐ[K] F)
    (hgen : IntermediateField.adjoin K ({u,y} : Set F) = ⊤)
    (hu : u ≠ 0) (hne : u⁻¹ ≠ u) (hus : u + algebraMap K F s ≠ 0)
    (hs : s^2=1) (ju : j u=u⁻¹) (jy : j y=algebraMap K F s*y/u^(2*k+1)) :
    IntermediateField.adjoin K ({u+u⁻¹,y*(u+algebraMap K F s)/u^(k+1)} : Set F) = reflectionFixedField j := by
  let X := u+u⁻¹
  let Z := y*(u+algebraMap K F s)/u^(k+1)
  let E := IntermediateField.adjoin K ({X,Z} : Set F)
  let R := reflectionFixedField j
  have hx : X ∈ E := IntermediateField.subset_adjoin K _ (by simp)
  have hz : Z ∈ E := IntermediateField.subset_adjoin K _ (by simp)
  have hle : E ≤ R := by
    apply IntermediateField.adjoin_le_iff.mpr
    intro z h
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
    rcases h with rfl | rfl
    · change j (u+u⁻¹)=u+u⁻¹
      rw [map_add, map_inv₀, ju, inv_inv, add_comm]
    · change j (y*(u+algebraMap K F s)/u^(k+1))=Z
      rw [map_div₀, map_mul, map_add, map_pow, ju, jy, j.commutes]
      exact signed_coordinate_invariant k u y _ hu (by rw [← map_pow, hs, map_one])
  let M := IntermediateField.adjoin E ({u} : Set F)
  have huM : u ∈ M := IntermediateField.subset_adjoin E _ (by simp)
  have hzM : Z ∈ M := M.algebraMap_mem ⟨Z,hz⟩
  have hsM : algebraMap K F s ∈ M := M.algebraMap_mem ⟨_,E.algebraMap_mem s⟩
  have hyM : y ∈ M := by
    have he : Z*u^(k+1)/(u+algebraMap K F s) = y := by
      dsimp only [Z]
      field_simp [hu,hus]
    have hp : u^(k+1) ∈ M := pow_mem huM (k+1)
    have hy := M.div_mem (M.mul_mem hzM hp) (M.add_mem huM hsM)
    rwa [he] at hy
  have htop : M = ⊤ := by
    apply (IntermediateField.restrictScalars_eq_top_iff (K := K)).mp
    apply top_le_iff.mp
    rw [← hgen]
    apply IntermediateField.adjoin_le_iff.mpr
    intro z hz'
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz'
    rcases hz' with rfl | rfl
    · exact huM
    · exact hyM
  let a : E := ⟨X,hx⟩
  have hquad : u^2-algebraMap E F a*u+algebraMap E F 1=0 := by
    rw [map_one]
    exact reciprocal_quadratic u hu
  have hle2 := Hypergeometric.EulerCover.finrank_adjoin_quadratic_le a 1 u hquad
  change Module.finrank E M ≤ 2 at hle2
  rw [htop, IntermediateField.finrank_top'] at hle2
  let : FiniteDimensional E F := by
    have hfin := IntermediateField.adjoin.finiteDimensional
      (Hypergeometric.EulerCover.isIntegral_of_quadratic a 1 u hquad)
    change FiniteDimensional E M at hfin
    rw [htop] at hfin
    exact Module.Finite.of_surjective
      (IntermediateField.topEquiv : (⊤ : IntermediateField E F) ≃ₐ[E] F).toLinearMap
      (IntermediateField.topEquiv : (⊤ : IntermediateField E F) ≃ₐ[E] F).surjective
  have hnot : R ≠ ⊤ := by
    intro eq
    have hmem : u ∈ R := eq ▸ trivial
    exact hne (ju.symm.trans hmem)
  have hd := IntermediateField.finrank_dvd_of_le_left hle
  have hpos : 0 < Module.finrank E F := Module.finrank_pos
  have hR0 : Module.finrank R F ≠ 0 := by rintro hh; rw [hh, zero_dvd_iff] at hd; omega
  have hR1 : Module.finrank R F ≠ 1 := fun hh => hnot (IntermediateField.finrank_eq_one_iff_eq_top.mp hh)
  have hRL := Nat.le_of_dvd hpos hd
  change E = R
  exact IntermediateField.eq_of_le_of_finrank_eq' hle (show Module.finrank E F = Module.finrank R F by omega)
end HilbertModularity.PaperI
