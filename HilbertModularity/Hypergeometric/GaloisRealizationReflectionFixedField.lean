/-! # The fixed field of the Euler reflection

The generic reflection of [GPRV, Proposition 9.5] is an actual nonidentity
automorphism of the Euler function field. Its fixed field has degree two.
The identification of this field with the selected smooth proper quotient's
function field is a separate geometric comparison.
-/

public noncomputable section

namespace HilbertModularity.Hypergeometric.EulerCover

variable {K : Type*} [Field K]

/-- The actual Euler function-field reflection has order two. -/
theorem genericReflectionFunctionFieldEquiv_orderOf (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (ht : t ≠ 0) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    orderOf (genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht) = 2 := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let r := genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht
  have hsq : r ^ 2 = 1 := by
    apply RingEquiv.ext
    intro a
    have h := congrArg
      (fun f : CoverFunctionField N m t →+* CoverFunctionField N m t => f a)
      (genericReflectionFunctionFieldHom_involutive N m t hN hmPos hm hcop ht)
    change r (r a) = a
    rw [genericReflectionFunctionFieldEquiv_apply,
      genericReflectionFunctionFieldEquiv_apply]
    simpa only [RingHom.comp_apply, RingHom.id_apply] using h
  have hne : r ≠ 1 := by
    change r ≠ RingEquiv.refl (CoverFunctionField N m t)
    exact genericReflectionFunctionFieldEquiv_ne_refl
      N m t hN hmPos hm hcop ht
  let : Fact (Nat.Prime 2) := ⟨by decide⟩
  exact orderOf_eq_prime hsq hne

/-- The fixed field of the subgroup generated by the explicit reflection
has index two in the generic Euler function field. -/
theorem genericReflectionFixedField_finrank (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (ht : t ≠ 0) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    let r := genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht
    Module.finrank (FixedPoints.subfield (Subgroup.zpowers r)
      (CoverFunctionField N m t)) (CoverFunctionField N m t) = 2 := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let r : RingAut F := genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht
  let : MulSemiringAction (RingAut F) F := RingAut.applyMulSemiringAction
  let : FaithfulSMul (RingAut F) F := RingAut.apply_faithfulSMul
  have horder : orderOf r = 2 :=
    genericReflectionFunctionFieldEquiv_orderOf N m t hN hmPos hm hcop ht
  have hfin : IsOfFinOrder r := isOfFinOrder_iff_pow_eq_one.mpr
    ⟨2, by decide, by rw [← horder]; exact pow_orderOf_eq_one r⟩
  have hcard : Nat.card (Subgroup.zpowers r) = 2 := by
    rw [Nat.card_zpowers, horder]
  let : Finite (Subgroup.zpowers r) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; decide)
  let : Fintype (Subgroup.zpowers r) := Fintype.ofFinite _
  calc
    Module.finrank (FixedPoints.subfield (Subgroup.zpowers r) F) F =
        Fintype.card (Subgroup.zpowers r) := FixedPoints.finrank_eq_card _ _
    _ = 2 := by
      simpa only [Nat.card_eq_fintype_card] using hcard

end HilbertModularity.Hypergeometric.EulerCover
