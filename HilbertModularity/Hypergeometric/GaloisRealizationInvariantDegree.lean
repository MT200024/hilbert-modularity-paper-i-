module

public import HilbertModularity.Hypergeometric.GaloisRealizationInvariantFixedField

/-! # Generators of the generic Euler function field

The fraction field of the actual Euler root algebra is generated over the
coefficient field by its base and covering coordinates. This is an algebraic
step toward identifying the explicit reflection invariants with a quotient
function field; it does not identify the chosen proper quotient map.
-/

public noncomputable section

open Polynomial

namespace HilbertModularity.Hypergeometric.EulerCover

variable {K : Type*} [Field K]

/-- The actual Euler function field is generated by the base coordinate and
the root coordinate of the defining cover equation. -/
theorem coverFunctionField_eq_adjoin_coordinates (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    IntermediateField.adjoin K
      ({coverFunctionFieldX N m t, coverFunctionFieldRoot N m t} :
        Set (CoverFunctionField N m t)) = ⊤ := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let B := BaseRing t
  let A := CoverRing N m t
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let y := coverFunctionFieldRoot N m t
  let E : IntermediateField K F := IntermediateField.adjoin K ({x, y} : Set F)
  have hx : x ∈ E := by
    apply IntermediateField.subset_adjoin
    simp
  have hy : y ∈ E := by
    apply IntermediateField.subset_adjoin
    simp
  have hpoly (p : K[X]) : algebraMap K[X] F p ∈ E := by
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      simpa only [map_add] using E.add_mem hp hq
    | monomial n a =>
      have heq : algebraMap K[X] F (Polynomial.monomial n a) =
          algebraMap K F a * x ^ n := by
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        simp only [map_mul, map_pow,
          IsScalarTower.algebraMap_apply K K[X] F]
        rfl
      rw [heq]
      exact E.mul_mem (E.algebraMap_mem a) (E.pow_mem hx n)
  have hbase (b : B) : algebraMap B F b ∈ E := by
    obtain ⟨⟨p, s⟩, hs⟩ :=
      IsLocalization.surj (Submonoid.powers (branchProduct t)) b
    have hu : IsUnit (algebraMap K[X] B (s : K[X])) :=
      IsLocalization.map_units B s
    have huF : IsUnit (algebraMap K[X] F (s : K[X])) := by
      rw [IsScalarTower.algebraMap_apply K[X] B F]
      exact hu.map (algebraMap B F)
    have hsF := congrArg (algebraMap B F) hs
    have heq : algebraMap B F b =
        algebraMap K[X] F p / algebraMap K[X] F (s : K[X]) := by
      apply (eq_div_iff huF.ne_zero).mpr
      simpa only [map_mul,
        IsScalarTower.algebraMap_apply K[X] B F] using hsF
    rw [heq]
    exact E.div_mem (hpoly p) (hpoly s)
  have hcover (a : A) : algebraMap A F a ∈ E := by
    refine AdjoinRoot.induction_on (coverPolynomial N m t) a ?_
    intro p
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      simpa only [map_add] using E.add_mem hp hq
    | monomial n b =>
      have heq : algebraMap A F
          ((AdjoinRoot.mk (coverPolynomial N m t)) (Polynomial.monomial n b)) =
          algebraMap B F b * y ^ n := by
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        simp only [map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
        simp only [y, coverFunctionFieldRoot, coverRoot]
        congr 1
      rw [heq]
      exact E.mul_mem (hbase b) (E.pow_mem hy n)
  apply le_antisymm
  · exact le_top
  · intro z hz
    obtain ⟨a, b, hb, hdiv⟩ := IsFractionRing.div_surjective A z
    rw [← hdiv]
    exact E.div_mem (hcover a) (hcover b)

end HilbertModularity.Hypergeometric.EulerCover
