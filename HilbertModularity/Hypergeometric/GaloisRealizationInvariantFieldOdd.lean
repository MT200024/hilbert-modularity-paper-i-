module

public import HilbertModularity.Hypergeometric.GaloisRealizationQuadraticDegree

/-! # Odd-degree identification of Euler reflection invariants

The actual covering coordinate is quadratic over the composite of the
invariant-coordinate field and the rational base-coordinate field. For an
odd-degree Euler cover this composite must be the whole function field.
-/

public noncomputable section

namespace HilbertModularity.Hypergeometric.EulerCover

variable {K : Type*} [Field K]

/-- A field embedding gives the same degree above its image as above its
source, for the algebra structure defined by that embedding. -/
theorem finrank_fieldRange_of_algebraMap {B F : Type*} [Field B] [Field F]
    [Algebra K B] [Algebra K F] (f : B →ₐ[K] F) [Algebra B F]
    (hf : ∀ b, algebraMap B F b = f b) :
    Module.finrank f.fieldRange F = Module.finrank B F := by
  have hsquare : (algebraMap f.fieldRange F).comp
      f.equivFieldRange.toRingEquiv.toRingHom =
      (RingEquiv.refl F).toRingHom.comp (algebraMap B F) := by
    ext b
    exact (AlgHom.equivFieldRange_apply_coe f b).trans (hf b).symm
  exact (Algebra.finrank_eq_of_equiv_equiv f.equivFieldRange.toRingEquiv
    (RingEquiv.refl F) hsquare).symm

/-- The Euler function field is generated by the covering coordinate over
the composite of the two explicit invariant-coordinate and rational-base
subfields. -/
theorem genericReflectionInvariantField_adjoin_root_eq_top (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    let F := CoverFunctionField N m t
    let E := genericReflectionInvariantField N m t hN hmPos hm hcop
    let M : IntermediateField K F := E ⊔
      IntermediateField.adjoin K ({coverFunctionFieldX N m t} : Set F)
    IntermediateField.adjoin M ({coverFunctionFieldRoot N m t} : Set F) = ⊤ := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let y := coverFunctionFieldRoot N m t
  let E := genericReflectionInvariantField N m t hN hmPos hm hcop
  let M : IntermediateField K F := E ⊔ IntermediateField.adjoin K ({x} : Set F)
  let A : IntermediateField M F := IntermediateField.adjoin M ({y} : Set F)
  have hxM : x ∈ M := by
    have hxKx : x ∈ IntermediateField.adjoin K ({x} : Set F) := by
      apply IntermediateField.subset_adjoin
      simp
    exact (show IntermediateField.adjoin K ({x} : Set F) ≤ M from le_sup_right) hxKx
  have hxA : x ∈ A := A.algebraMap_mem ⟨x, hxM⟩
  have hyA : y ∈ A := by
    apply IntermediateField.subset_adjoin
    simp
  apply le_antisymm le_top
  intro z hz
  have hgen : z ∈ IntermediateField.adjoin K ({x, y} : Set F) := by
    rw [coverFunctionField_eq_adjoin_coordinates N m t hN hmPos hm hcop]
    trivial
  refine IntermediateField.adjoin_induction K (p := fun z _ => z ∈ A)
    ?_ ?_ ?_ ?_ ?_ hgen
  · intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with hz | hz
    · simpa only [hz] using hxA
    · simpa only [hz] using hyA
  · intro a
    exact A.algebraMap_mem ⟨algebraMap K F a, M.algebraMap_mem a⟩
  · intro a b ha hb iha ihb
    exact A.add_mem iha ihb
  · intro a ha iha
    exact A.inv_mem iha
  · intro a b ha hb iha ihb
    exact A.mul_mem iha ihb

/-- For odd covering degree, adjoining the base coordinate to the explicit
reflection invariants already gives the entire Euler function field. -/
theorem genericReflectionInvariantField_sup_base_eq_top (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (ht : t ≠ 0) (hodd : Odd N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    let F := CoverFunctionField N m t
    let E := genericReflectionInvariantField N m t hN hmPos hm hcop
    E ⊔ IntermediateField.adjoin K ({coverFunctionFieldX N m t} : Set F) = ⊤ := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let : Algebra (BaseFunctionField t) (CoverFunctionField N m t) :=
    coverFunctionFieldAlgebra N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let B : IntermediateField K F := IntermediateField.adjoin K ({x} : Set F)
  let E : IntermediateField K F := genericReflectionInvariantField N m t hN hmPos hm hcop
  let M : IntermediateField K F := E ⊔ B
  have hB : Module.finrank B F = N := by
    let f := baseFunctionFieldToCoverAlgHom N m t hN hmPos hm hcop
    have hrange : f.fieldRange = B :=
      baseFunctionFieldToCoverAlgHom_fieldRange N m t hN hmPos hm hcop
    rw [← hrange]
    have hf : ∀ b, algebraMap (BaseFunctionField t) F b = f b := by
      intro b
      change baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop b = f b
      exact (baseFunctionFieldToCoverAlgHom_apply N m t hN hmPos hm hcop b).symm
    rw [finrank_fieldRange_of_algebraMap f hf]
    exact coverFunctionField_finrank N m t hN hmPos hm hcop
  have hMle : Module.finrank M F ≤ 2 := by
    have htop := genericReflectionInvariantField_adjoin_root_eq_top
      N m t hN hmPos hm hcop
    have hquad := genericReflectionInvariantY_degree_le_two
      N m t hN hmPos hm hcop ht
    change IntermediateField.adjoin M
      ({coverFunctionFieldRoot N m t} : Set F) = ⊤ at htop
    change Module.finrank M
      (IntermediateField.adjoin M ({coverFunctionFieldRoot N m t} : Set F)) ≤ 2
      at hquad
    rw [htop] at hquad
    simpa only [IntermediateField.finrank_top'] using hquad
  have hdvd : Module.finrank M F ∣ N := by
    have hdiv : Module.finrank M F ∣ Module.finrank B F :=
      IntermediateField.finrank_dvd_of_le_left le_sup_right
    simpa only [hB] using hdiv
  have hone : Module.finrank M F = 1 := by
    have hpos : 0 < Module.finrank M F := by
      by_contra hn
      have hz : Module.finrank M F = 0 := by omega
      simp only [hz, zero_dvd_iff] at hdvd
      exact hN hdvd
    have hcase : Module.finrank M F = 1 ∨ Module.finrank M F = 2 := by omega
    rcases hcase with hcase | hcase
    · exact hcase
    · have htwo : 2 ∣ N := by simpa only [hcase] using hdvd
      obtain ⟨k, hk⟩ := hodd
      omega
  exact IntermediateField.finrank_eq_one_iff_eq_top.mp hone

/-- For odd covering degree, the Euler base coordinate generates the entire
function field over the field of the two explicit reflection invariants. -/
theorem genericReflectionInvariantField_adjoin_X_eq_top (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (ht : t ≠ 0) (hodd : Odd N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    let F := CoverFunctionField N m t
    let E := genericReflectionInvariantField N m t hN hmPos hm hcop
    IntermediateField.adjoin E ({coverFunctionFieldX N m t} : Set F) = ⊤ := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let E : IntermediateField K F := genericReflectionInvariantField N m t hN hmPos hm hcop
  have hres :
      (IntermediateField.adjoin E ({coverFunctionFieldX N m t} : Set F)).restrictScalars K
        = ⊤ := by
    rw [IntermediateField.restrictScalars_adjoin_eq_sup]
    exact genericReflectionInvariantField_sup_base_eq_top
      N m t hN hmPos hm hcop ht hodd
  exact IntermediateField.restrictScalars_eq_top_iff.mp hres

end HilbertModularity.Hypergeometric.EulerCover
