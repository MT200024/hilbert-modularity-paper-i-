/-! # Cyclotomic entries in the prime-level modularity checklist

The residual character is taken on the absolute Galois group of the real
cyclotomic field inside `Qbar`.  Its fixed field, value at complex
conjugation, and local order are the arithmetic entries of
[TripathiGoswamiRevised, Proposition `SW-checklist`].  Identifying this
character with the ratio of the constituents of the chosen Darmon fibre
requires transport from the algebraic closure used by that fibre.
-/

public section
noncomputable section

open scoped NumberField Pointwise

namespace HilbertModularity.Hypergeometric

open HilbertModularity.Cyclotomic

/-- The cyclotomic field cut out by the residual character is abelian over
`ℚ`, the character is odd, and its restriction at the conductor has exact
order two.  The complex embedding specifies the real place; the prime of
`Qbar` specifies the local decomposition group.  These are the cyclotomic
parts of [TripathiGoswamiRevised, Proposition `SW-checklist`]. -/
theorem residualCyclotomic_SW_conditions
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (Q : Ideal (𝓞 Qbar)) [Q.IsPrime]
    [Q.LiesOver (realPrimeAboveConductor p).asIdeal]
    (ι : Qbar →+* ℂ)
    (c : Qbar ≃ₐ[realCyclotomicField p] Qbar)
    (hc : ∀ x, ι (c x) = star (ι x)) :
    (IntermediateField.fixedField (residualCharacter p).ker).restrictScalars ℚ =
        cyclotomicField p ∧
      residualCharacter p c = -1 ∧
      orderOf ((residualCharacter p).comp
        (MulAction.stabilizer (Qbar ≃ₐ[realCyclotomicField p] Qbar) Q).subtype) = 2 := by
  have hp2 : Fact (2 < p) := ⟨by omega⟩
  exact ⟨fixedField_ker_residualCharacter p,
    residualCharacter_complexConjugation p ι c hc,
    @orderOf_residualCharacter_at_conductor p _ hp2 Q _ _⟩

/-- On any algebraic closure of the real cyclotomic field, the residual
character of the canonical coefficient prime is the action on a primitive
`p`-th root. This connects the character of the chosen Darmon kernel to the
cyclotomic fixed-field calculation in
[TripathiGoswamiRevised, Proposition `primeresidual`]. -/
theorem realPrimeResidualCharacter_on_primitiveRoot
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (ζ : AlgebraicClosure (realCyclotomicField p)) (hζ : IsPrimitiveRoot ζ p)
    (g : AlgebraicClosure (realCyclotomicField p) ≃ₐ[realCyclotomicField p]
      AlgebraicClosure (realCyclotomicField p)) :
    realPrimeResidueEquiv p (by omega)
      (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega) g :
          𝓞 (realCyclotomicField p) ⧸ Ideal.span {realPrimeGenerator p}) =
      (hζ.autToPow (realCyclotomicField p) g : ZMod p) := by
  rw [AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter_residue]
  change (_root_.cyclotomicCharacter (AlgebraicClosure (realCyclotomicField p)) p
    g.toRingEquiv : ℤ_[p]).toZMod = _
  rw [_root_.cyclotomicCharacter.toZMod p hζ.card_rootsOfUnity g.toRingEquiv]
  exact congrArg Units.val
    (hζ.autToPow_eq_modularCyclotomicCharacter p (realCyclotomicField p) g).symm

/-- The kernel of the chosen closure's residual character fixes precisely
the field generated by the primitive root over the real base field. -/
theorem fixedField_realPrimeResidualCharacter
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (ζ : AlgebraicClosure (realCyclotomicField p)) (hζ : IsPrimitiveRoot ζ p) :
    IntermediateField.fixedField
      (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)).ker =
      IntermediateField.adjoin (realCyclotomicField p) {ζ} := by
  have hker :
      (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)).ker =
        (hζ.autToPow (realCyclotomicField p)).ker := by
    ext g
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
    constructor
    · intro hg
      apply Units.ext
      rw [← realPrimeResidualCharacter_on_primitiveRoot p hp ζ hζ g, hg]
      simp
    · intro hg
      apply Units.ext
      apply (realPrimeResidueEquiv p (by omega)).injective
      rw [realPrimeResidualCharacter_on_primitiveRoot p hp ζ hζ g, hg]
      simp
  rw [hker, hζ.fixedField_ker_autToPow]

/-- Identify the algebraic closure used by the chosen Darmon fibre with the
fixed algebraic closure containing the cyclotomic fields. -/
def realCyclotomicClosureEquiv (p : ℕ) [NeZero p] :
    AlgebraicClosure (realCyclotomicField p) ≃ₐ[realCyclotomicField p] Qbar := by
  letI : IsAlgClosure (realCyclotomicField p) Qbar :=
    IsAlgClosure.ofAlgebraic (realCyclotomicField p) Qbar Qbar
  exact IsAlgClosure.equiv _ _ _

/-- Conjugation by the chosen algebraic-closure equivalence identifies the
two absolute Galois groups of the real cyclotomic field. -/
def realCyclotomicGaloisEquiv (p : ℕ) [NeZero p] :
    (Qbar ≃ₐ[realCyclotomicField p] Qbar) ≃*
      (AlgebraicClosure (realCyclotomicField p) ≃ₐ[realCyclotomicField p]
        AlgebraicClosure (realCyclotomicField p)) where
  toFun g := (((realCyclotomicClosureEquiv p).trans g).trans
    (realCyclotomicClosureEquiv p).symm)
  invFun g := (((realCyclotomicClosureEquiv p).symm.trans g).trans
    (realCyclotomicClosureEquiv p))
  left_inv g := by ext x; simp
  right_inv g := by ext x; simp
  map_mul' g h := by ext x; simp

/-- The chosen closure equivalence transports a Galois automorphism by
conjugation. -/
theorem realCyclotomicGaloisEquiv_apply (p : ℕ) [NeZero p]
    (g : Qbar ≃ₐ[realCyclotomicField p] Qbar) :
    realCyclotomicGaloisEquiv p g =
      (((realCyclotomicClosureEquiv p).trans g).trans
        (realCyclotomicClosureEquiv p).symm) := (rfl)

/-- Under the algebraic-closure identification, the residual character of
the chosen canonical-prime kernel agrees with the cyclotomic character on
`Qbar`. This is the character identification used in
[TripathiGoswamiRevised, Proposition `primeresidual`]. -/
theorem realPrimeResidualCharacter_transport
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (g : Qbar ≃ₐ[realCyclotomicField p] Qbar) :
    realPrimeResidueEquiv p (by omega)
      (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)
          (((realCyclotomicClosureEquiv p).trans g).trans
            (realCyclotomicClosureEquiv p).symm) :
          𝓞 (realCyclotomicField p) ⧸ Ideal.span {realPrimeGenerator p}) =
      (residualCharacter p g : ZMod p) := by
  let e := realCyclotomicClosureEquiv p
  let ζ' : AlgebraicClosure (realCyclotomicField p) := e.symm (zeta p)
  have hζ' : IsPrimitiveRoot ζ' p :=
    (zeta_isPrimitiveRoot p).map_of_injective e.symm.injective
  rw [realPrimeResidualCharacter_on_primitiveRoot p hp ζ' hζ']
  change (hζ'.autToPow (realCyclotomicField p) ((e.trans g).trans e.symm) : ZMod p) =
    (residualCharacter p g : ZMod p)
  have hunit : hζ'.autToPow (realCyclotomicField p) ((e.trans g).trans e.symm) =
      residualCharacter p g := by
    apply Units.ext
    apply ZMod.val_injective
    apply hζ'.pow_inj (ZMod.val_lt _) (ZMod.val_lt _)
    calc
      ζ' ^ ((hζ'.autToPow (realCyclotomicField p) ((e.trans g).trans e.symm) :
        ZMod p).val) = ((e.trans g).trans e.symm) ζ' :=
          hζ'.autToPow_spec (realCyclotomicField p) _
      _ = e.symm (g (zeta p)) := by simp [ζ', e]
      _ = e.symm ((zeta p) ^ ((residualCharacter p g : ZMod p).val)) :=
        congrArg e.symm ((zeta_isPrimitiveRoot p).autToPow_spec
          (realCyclotomicField p) g).symm
      _ = ζ' ^ ((residualCharacter p g : ZMod p).val) := by simp [ζ']
  exact congrArg Units.val hunit

/-- The chosen kernel character takes only the two values allowed by the
quadratic cyclotomic extension. This is the constituent-ordering fact in
[TripathiGoswamiRevised, Proposition `primeresidual`]. -/
theorem realPrimeResidualCharacter_eq_one_or_neg_one
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (g : AlgebraicClosure (realCyclotomicField p) ≃ₐ[realCyclotomicField p]
      AlgebraicClosure (realCyclotomicField p)) :
    AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega) g = 1 ∨
      AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega) g = -1 := by
  let e := realCyclotomicGaloisEquiv p
  let g' := e.symm g
  let u := realPrimeResidueEquiv p (by omega)
  have h := realPrimeResidualCharacter_transport p hp g'
  change u (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
    (realCyclotomicField p) p (by omega) (e g')) =
      (residualCharacter p g' : ZMod p) at h
  rw [e.apply_symm_apply] at h
  have hp1 : Fact (1 < p) := ⟨by omega⟩
  rcases residualCharacter_eq_one_or_neg_one p g' with h₁ | h₁
  · left
    apply Units.ext
    apply u.injective
    simpa [h₁] using h
  · right
    apply Units.ext
    apply u.injective
    simpa [h₁] using h

/-- Reversing the two residual constituents leaves their character ratio
unchanged for the chosen real cyclotomic base. -/
theorem realPrimeResidualCharacter_inv_eq
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p) :
    (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
      (realCyclotomicField p) p (by omega))⁻¹ =
      AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega) := by
  ext g
  rcases realPrimeResidualCharacter_eq_one_or_neg_one p hp g with h | h
  · simp [h]
  · simp [h]

/-- The residual character of the chosen canonical-prime kernel is odd at
the complex conjugation transported from `Qbar`.  The algebraic-closure
equivalence fixes the real cyclotomic base, so this is an actual complex
conjugation of the chosen fibre's Galois group.  This is the oddness entry in
[TripathiGoswamiRevised, Proposition `SW-checklist`]. -/
theorem realPrimeResidualCharacter_complexConjugation
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (ι : Qbar →+* ℂ)
    (c : Qbar ≃ₐ[realCyclotomicField p] Qbar)
    (hc : ∀ x, ι (c x) = star (ι x)) :
    AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
      (realCyclotomicField p) p (by omega)
        (((realCyclotomicClosureEquiv p).trans c).trans
          (realCyclotomicClosureEquiv p).symm) = -1 := by
  apply Units.ext
  apply (realPrimeResidueEquiv p (by omega)).injective
  rw [realPrimeResidualCharacter_transport p hp c,
    residualCharacter_complexConjugation p ι c hc]
  simp

/-- On the decomposition group transported from any prime of `Qbar` above the
conductor, the chosen canonical-prime residual character has exact order two.
This is the distinguished local-ratio entry of
[TripathiGoswamiRevised, Proposition `SW-checklist`]. -/
theorem orderOf_realPrimeResidualCharacter_at_conductor
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (Q : Ideal (𝓞 Qbar)) [Q.IsPrime]
    [Q.LiesOver (realPrimeAboveConductor p).asIdeal] :
    orderOf ((AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
      (realCyclotomicField p) p (by omega)).comp
        ((realCyclotomicGaloisEquiv p).toMonoidHom.comp
          (MulAction.stabilizer (Qbar ≃ₐ[realCyclotomicField p] Qbar) Q).subtype)) = 2 := by
  let D := MulAction.stabilizer (Qbar ≃ₐ[realCyclotomicField p] Qbar) Q
  let e := realPrimeResidueEquiv p (by omega)
  let u := Units.map e.toMonoidHom
  have hu : Function.Injective u := by
    intro a b hab
    apply Units.ext
    apply e.injective
    exact congrArg Units.val hab
  let post :
      (D →* (𝓞 (realCyclotomicField p) ⧸
        Ideal.span {realPrimeGenerator p})ˣ) →*
        (D →* (ZMod p)ˣ) := {
    toFun := fun χ => u.comp χ
    map_one' := by ext g; simp [u]
    map_mul' := by intro χ ψ; ext g; simp [u]
  }
  have hpost : Function.Injective post := by
    intro χ ψ hχ
    ext g
    exact congrArg Units.val
      (hu (congrArg (fun f : D →* (ZMod p)ˣ => f g) hχ))
  have heq : post ((AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)).comp
          ((realCyclotomicGaloisEquiv p).toMonoidHom.comp D.subtype)) =
      (residualCharacter p).comp D.subtype := by
    ext g
    change e (AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)
          (((realCyclotomicClosureEquiv p).trans g.1).trans
            (realCyclotomicClosureEquiv p).symm)) =
      (residualCharacter p g.1 : ZMod p)
    exact realPrimeResidualCharacter_transport p hp g.1
  calc
    orderOf ((AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)).comp
          ((realCyclotomicGaloisEquiv p).toMonoidHom.comp D.subtype)) =
      orderOf (post ((AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega)).comp
          ((realCyclotomicGaloisEquiv p).toMonoidHom.comp D.subtype))) :=
        (orderOf_injective post hpost _).symm
    _ = orderOf ((residualCharacter p).comp D.subtype) := by rw [heq]
    _ = 2 := by
      have hp2 : Fact (2 < p) := ⟨by omega⟩
      exact @orderOf_residualCharacter_at_conductor p _ hp2 Q _ _

/-- For the two explicit residual constituents of the chosen prime kernel,
their ratio is cyclotomic in either ordering. Its fixed field, oddness and
distinguished local order are the arithmetic conclusions of
[TripathiGoswamiRevised, Propositions `primeresidual` and `SW-checklist`].
The character-pair premise is supplied by the same-fibre fixed point and
determinant deduction. -/
theorem realPrimeResidualRatio_conditions
    (p : ℕ) [Fact p.Prime] (hp : 3 ≤ p)
    (χ₁ χ₂ : (AlgebraicClosure (realCyclotomicField p) ≃ₐ[realCyclotomicField p]
      AlgebraicClosure (realCyclotomicField p)) →*
        (𝓞 (realCyclotomicField p) ⧸ Ideal.span {realPrimeGenerator p})ˣ)
    (hchars : (χ₁ = 1 ∧ χ₂ = AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
          (realCyclotomicField p) p (by omega)) ∨
        (χ₁ = AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
          (realCyclotomicField p) p (by omega) ∧ χ₂ = 1))
    (ζ : AlgebraicClosure (realCyclotomicField p)) (hζ : IsPrimitiveRoot ζ p)
    (ι : Qbar →+* ℂ)
    (c : Qbar ≃ₐ[realCyclotomicField p] Qbar)
    (hc : ∀ x, ι (c x) = star (ι x))
    (Q : Ideal (𝓞 Qbar)) [Q.IsPrime]
    [Q.LiesOver (realPrimeAboveConductor p).asIdeal] :
    let ratio := χ₁ * χ₂⁻¹
    ratio = AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega) ∧
      IntermediateField.fixedField ratio.ker =
        IntermediateField.adjoin (realCyclotomicField p) {ζ} ∧
      ratio (((realCyclotomicClosureEquiv p).trans c).trans
        (realCyclotomicClosureEquiv p).symm) = -1 ∧
      orderOf (ratio.comp
        ((realCyclotomicGaloisEquiv p).toMonoidHom.comp
          (MulAction.stabilizer (Qbar ≃ₐ[realCyclotomicField p] Qbar) Q).subtype)) = 2 := by
  dsimp only
  have hratio : χ₁ * χ₂⁻¹ =
      AlgebraicGeometry.GroupScheme.realPrimeResidualCyclotomicCharacter
        (realCyclotomicField p) p (by omega) := by
    rcases hchars with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · ext g
      simp [realPrimeResidualCharacter_inv_eq p hp]
    · ext g
      simp
  refine ⟨hratio, ?_, ?_, ?_⟩ <;> rw [hratio]
  · exact fixedField_realPrimeResidualCharacter p hp ζ hζ
  · exact realPrimeResidualCharacter_complexConjugation p hp ι c hc
  · exact orderOf_realPrimeResidualCharacter_at_conductor p hp Q

end HilbertModularity.Hypergeometric
