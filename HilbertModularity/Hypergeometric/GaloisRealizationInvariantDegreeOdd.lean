module

public import HilbertModularity.Hypergeometric.GaloisRealizationInvariantDegree

/-! # Odd-degree Euler invariants

The rational base field of the actual Euler cover lies in the field generated
by its base coordinate. This prepares the odd-degree argument identifying the
explicit invariant coordinates with the reflection fixed field.
-/

public noncomputable section

open Polynomial

namespace HilbertModularity.Hypergeometric.EulerCover

variable {K : Type*} [Field K]

/-- The actual rational-function base embeds into the field generated by the
base coordinate of the Euler cover. -/
theorem baseFunctionField_image_mem_adjoin_X (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (b : BaseFunctionField t) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop b ∈
      IntermediateField.adjoin K ({coverFunctionFieldX N m t} :
        Set (CoverFunctionField N m t)) := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let B := BaseRing t
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let E : IntermediateField K F := IntermediateField.adjoin K ({x} : Set F)
  have hx : x ∈ E := by
    apply IntermediateField.subset_adjoin
    simp
  have hpoly (p : K[X]) : algebraMap K[X] F p ∈ E := by
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      simpa only [map_add] using E.add_mem hp hq
    | monomial n a =>
      have heq : algebraMap K[X] F (Polynomial.monomial n a) =
          algebraMap K F a * x ^ n := by
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        simp only [map_mul, map_pow,
          IsScalarTower.algebraMap_apply K K[X] F]
        rfl
      rw [heq]
      exact E.mul_mem (E.algebraMap_mem a) (E.pow_mem hx n)
  have hbase (a : B) : algebraMap B F a ∈ E := by
    obtain ⟨⟨p, s⟩, hs⟩ :=
      IsLocalization.surj (Submonoid.powers (branchProduct t)) a
    have hu : IsUnit (algebraMap K[X] B (s : K[X])) :=
      IsLocalization.map_units B s
    have huF : IsUnit (algebraMap K[X] F (s : K[X])) := by
      rw [IsScalarTower.algebraMap_apply K[X] B F]
      exact hu.map (algebraMap B F)
    have hsF := congrArg (algebraMap B F) hs
    have heq : algebraMap B F a =
        algebraMap K[X] F p / algebraMap K[X] F (s : K[X]) := by
      apply (eq_div_iff huF.ne_zero).mpr
      simpa only [map_mul,
        IsScalarTower.algebraMap_apply K[X] B F] using hsF
    rw [heq]
    exact E.div_mem (hpoly p) (hpoly s)
  obtain ⟨a, c, hc, hdiv⟩ := IsFractionRing.div_surjective B b
  rw [← hdiv, map_div₀,
    baseFunctionFieldToCoverFunctionField_algebraMap,
    baseFunctionFieldToCoverFunctionField_algebraMap]
  exact E.div_mem (hbase a) (hbase c)

/-- The rational-function base embedding as an algebra homomorphism over the
coefficient field. -/
noncomputable def baseFunctionFieldToCoverAlgHom (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    BaseFunctionField t →ₐ[K] CoverFunctionField N m t := by
  letI : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  refine { baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop with
    commutes' := ?_ }
  intro a
  change baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop
    (algebraMap (BaseRing t) (BaseFunctionField t) (algebraMap K (BaseRing t) a)) = _
  rw [baseFunctionFieldToCoverFunctionField_algebraMap]
  exact (IsScalarTower.algebraMap_apply K (BaseRing t)
    (CoverFunctionField N m t) a).symm

/-- The algebra homomorphism uses the original generic Euler field embedding. -/
theorem baseFunctionFieldToCoverAlgHom_apply (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (b : BaseFunctionField t) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    baseFunctionFieldToCoverAlgHom N m t hN hmPos hm hcop b =
      baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop b := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  rfl

/-- The image of the actual rational-function base is precisely the field
generated by the Euler cover's base coordinate. -/
theorem baseFunctionFieldToCoverAlgHom_fieldRange (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    (baseFunctionFieldToCoverAlgHom N m t hN hmPos hm hcop).fieldRange =
      IntermediateField.adjoin K ({coverFunctionFieldX N m t} :
        Set (CoverFunctionField N m t)) := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let f := baseFunctionFieldToCoverAlgHom N m t hN hmPos hm hcop
  let x := coverFunctionFieldX N m t
  apply le_antisymm
  · intro z hz
    obtain ⟨b, rfl⟩ := f.mem_fieldRange.mp hz
    change baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop b ∈
      IntermediateField.adjoin K ({x} : Set (CoverFunctionField N m t))
    exact baseFunctionField_image_mem_adjoin_X N m t hN hmPos hm hcop b
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    have hz' : z = x := by simpa [x] using hz
    subst z
    apply f.mem_fieldRange.mpr
    refine ⟨algebraMap (BaseRing t) (BaseFunctionField t)
      (algebraMap K[X] (BaseRing t) X), ?_⟩
    change baseFunctionFieldToCoverFunctionField N m t hN hmPos hm hcop
      (algebraMap (BaseRing t) (BaseFunctionField t)
        (algebraMap K[X] (BaseRing t) X)) = x
    exact baseFunctionFieldToCoverFunctionField_X N m t hN hmPos hm hcop

end HilbertModularity.Hypergeometric.EulerCover
