module

public import HilbertModularity.Hypergeometric.GaloisRealizationInvariantDegreeOdd

/-! # Quadratic degree bound for invariant coordinates

The two rational coordinates of the Euler reflection yield monic quadratic
equations. This elementary field-theory lemma bounds the degree after adjoining
one of their roots, including in residue characteristic two.
-/

public noncomputable section

open Polynomial

namespace HilbertModularity.Hypergeometric.EulerCover

/-- A root of a monic quadratic is integral over its coefficient field. -/
theorem isIntegral_of_quadratic {L F : Type*} [Field L] [Field F]
    [Algebra L F] (a b : L) (x : F)
    (h : x ^ 2 - algebraMap L F a * x + algebraMap L F b = 0) :
    IsIntegral L x := by
  let p : L[X] := X ^ 2 - C a * X + C b
  have hm : p.Monic := (isMonicOfDegree_sub_add_two a b).monic
  have hp : aeval x p = 0 := by
    simpa [p] using h
  exact ⟨p, hm, hp⟩

/-- A root of a monic quadratic generates an extension of degree at most two. -/
theorem finrank_adjoin_quadratic_le {L F : Type*} [Field L] [Field F]
    [Algebra L F] (a b : L) (x : F)
    (h : x ^ 2 - algebraMap L F a * x + algebraMap L F b = 0) :
    Module.finrank L (IntermediateField.adjoin L ({x} : Set F)) ≤ 2 := by
  let p : L[X] := X ^ 2 - C a * X + C b
  have hm : p.Monic := (isMonicOfDegree_sub_add_two a b).monic
  have hp : aeval x p = 0 := by
    simpa [p] using h
  have hi : IsIntegral L x := isIntegral_of_quadratic a b x h
  rw [IntermediateField.adjoin.finrank hi]
  have hd := natDegree_le_natDegree (minpoly.min L x hm hp)
  have hpdeg : p.natDegree = 2 := (isMonicOfDegree_sub_add_two a b).1
  simpa only [hpdeg] using hd

/-- The Euler base coordinate is quadratic over the field of explicit
reflection invariants. -/
theorem genericReflectionInvariantX_degree_le_two {K : Type*} [Field K]
    (N m : ℕ) (t : K) (hN : N ≠ 0) (hmPos : 1 ≤ m)
    (hm : m < N) (hcop : m.Coprime N) (ht : t ≠ 0) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    let E := genericReflectionInvariantField N m t hN hmPos hm hcop
    Module.finrank E
      (IntermediateField.adjoin E ({coverFunctionFieldX N m t} :
        Set (CoverFunctionField N m t))) ≤ 2 := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let u := algebraMap K F t
  let E : IntermediateField K F := genericReflectionInvariantField N m t hN hmPos hm hcop
  have hx : x ≠ 0 := by
    simpa [x] using (genericOpenEulerPoint N m t hN hmPos hm hcop).x_ne_zero
  have hu : u ≠ 0 := (map_ne_zero (algebraMap K F)).mpr ht
  let a : E := ⟨(genericReflectionInvariantCoordinates N m t hN hmPos hm hcop).1,
    genericReflectionInvariantX_mem N m t hN hmPos hm hcop⟩
  let b : E := ⟨u⁻¹, E.inv_mem (E.algebraMap_mem t)⟩
  have hquad : x ^ 2 - algebraMap E F a * x + algebraMap E F b = 0 := by
    simp only [IntermediateField.algebraMap_apply]
    change x ^ 2 - (genericReflectionInvariantCoordinates N m t hN hmPos hm hcop).1
      * x + u⁻¹ = 0
    rw [genericReflectionInvariantCoordinates_fst]
    exact reflectionInvariantX_quadratic hu hx
  simpa only [E, x] using finrank_adjoin_quadratic_le a b x hquad

/-- The Euler base coordinate is integral over the field generated by the
two explicit reflection invariants. -/
theorem genericReflectionInvariantX_isIntegral {K : Type*} [Field K]
    (N m : ℕ) (t : K) (hN : N ≠ 0) (hmPos : 1 ≤ m)
    (hm : m < N) (hcop : m.Coprime N) (ht : t ≠ 0) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    IsIntegral (genericReflectionInvariantField N m t hN hmPos hm hcop)
      (coverFunctionFieldX N m t) := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let u := algebraMap K F t
  let E : IntermediateField K F := genericReflectionInvariantField N m t hN hmPos hm hcop
  have hx : x ≠ 0 := by
    simpa [x] using (genericOpenEulerPoint N m t hN hmPos hm hcop).x_ne_zero
  have hu : u ≠ 0 := (map_ne_zero (algebraMap K F)).mpr ht
  let a : E := ⟨(genericReflectionInvariantCoordinates N m t hN hmPos hm hcop).1,
    genericReflectionInvariantX_mem N m t hN hmPos hm hcop⟩
  let b : E := ⟨u⁻¹, E.inv_mem (E.algebraMap_mem t)⟩
  have hquad : x ^ 2 - algebraMap E F a * x + algebraMap E F b = 0 := by
    simp only [IntermediateField.algebraMap_apply]
    change x ^ 2 - (genericReflectionInvariantCoordinates N m t hN hmPos hm hcop).1
      * x + u⁻¹ = 0
    rw [genericReflectionInvariantCoordinates_fst]
    exact reflectionInvariantX_quadratic hu hx
  exact isIntegral_of_quadratic a b x hquad

/-- The Euler covering coordinate is quadratic over the composite of the
explicit invariant field with the rational base-coordinate field. -/
theorem genericReflectionInvariantY_degree_le_two {K : Type*} [Field K]
    (N m : ℕ) (t : K) (hN : N ≠ 0) (hmPos : 1 ≤ m)
    (hm : m < N) (hcop : m.Coprime N) (ht : t ≠ 0) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    let F := CoverFunctionField N m t
    let E := genericReflectionInvariantField N m t hN hmPos hm hcop
    let M : IntermediateField K F := E ⊔
      IntermediateField.adjoin K ({coverFunctionFieldX N m t} : Set F)
    Module.finrank M
      (IntermediateField.adjoin M ({coverFunctionFieldRoot N m t} : Set F)) ≤ 2 := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let x := coverFunctionFieldX N m t
  let y := coverFunctionFieldRoot N m t
  let u := algebraMap K F t
  let E : IntermediateField K F := genericReflectionInvariantField N m t hN hmPos hm hcop
  let M : IntermediateField K F := E ⊔ IntermediateField.adjoin K ({x} : Set F)
  have hx : x ≠ 0 := by
    simpa [x] using (genericOpenEulerPoint N m t hN hmPos hm hcop).x_ne_zero
  have hy : y ≠ 0 := by
    simpa [y] using (genericOpenEulerPoint N m t hN hmPos hm hcop).y_ne_zero
  have hu : u ≠ 0 := (map_ne_zero (algebraMap K F)).mpr ht
  have hxM : x ∈ M := by
    have hxKx : x ∈ IntermediateField.adjoin K ({x} : Set F) := by
      apply IntermediateField.subset_adjoin
      simp
    exact (show IntermediateField.adjoin K ({x} : Set F) ≤ M from le_sup_right)
      hxKx
  have huM : u ∈ M := M.algebraMap_mem t
  have hvM : (genericReflectionInvariantCoordinates N m t hN hmPos hm hcop).2 ∈ M :=
    (show E ≤ M from le_sup_left)
      (genericReflectionInvariantY_mem N m t hN hmPos hm hcop)
  have hcM : (1 - x) * (1 - u * x) / (u * x) ∈ M := by
    apply M.div_mem
    · exact M.mul_mem (M.sub_mem (M.one_mem) hxM)
        (M.sub_mem (M.one_mem) (M.mul_mem huM hxM))
    · exact M.mul_mem huM hxM
  let a : M := ⟨_, hvM⟩
  let b : M := ⟨-((1 - x) * (1 - u * x) / (u * x)), M.neg_mem hcM⟩
  have hquad : y ^ 2 - algebraMap M F a * y + algebraMap M F b = 0 := by
    simp only [IntermediateField.algebraMap_apply]
    change y ^ 2 - (genericReflectionInvariantCoordinates N m t hN hmPos hm hcop).2
      * y + -((1 - x) * (1 - u * x) / (u * x)) = 0
    rw [genericReflectionInvariantCoordinates_snd]
    simpa only [sub_eq_add_neg] using reflectionInvariantY_quadratic hu hx hy
  simpa only [M, E, x, y] using finrank_adjoin_quadratic_le a b y hquad

end HilbertModularity.Hypergeometric.EulerCover
