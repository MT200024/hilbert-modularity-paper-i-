/-! # Odd-degree Euler reflection fixed field

For an odd-degree Euler cover, the field generated by the two explicit
rational invariant coordinates is exactly the fixed field of the actual
generic reflection. The quotient map's function-field image remains a
separate geometric identification.
-/

public noncomputable section

namespace HilbertModularity.Hypergeometric.EulerCover

variable {K : Type*} [Field K]

/-- The actual reflection fixed field, with its inherited coefficient-field
structure. -/
noncomputable def genericReflectionFixedIntermediateField (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (ht : t ≠ 0) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    IntermediateField K (CoverFunctionField N m t) := by
  letI : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let r : RingAut F := genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht
  letI : MulSemiringAction (RingAut F) F := RingAut.applyMulSemiringAction
  refine { FixedPoints.subfield (Subgroup.zpowers r) F with
    algebraMap_mem' := ?_ }
  intro a
  change ∀ g : Subgroup.zpowers r, g • algebraMap K F a = algebraMap K F a
  intro g
  apply smul_eq_self_of_mem_zpowers g.property
  change (genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht)
      (algebraMap K F a) = algebraMap K F a
  rw [genericReflectionFunctionFieldEquiv_apply]
  exact genericReflectionFunctionFieldHom_const N m t hN hmPos hm hcop ht a

/-- In odd covering degree, the explicit invariant coordinates generate the
entire reflection fixed field. -/
theorem genericReflectionInvariantField_eq_fixedField (N m : ℕ) (t : K)
    (hN : N ≠ 0) (hmPos : 1 ≤ m) (hm : m < N) (hcop : m.Coprime N)
    (ht : t ≠ 0) (hodd : Odd N) :
    letI := coverRing_isDomain N m t hN hmPos hm hcop
    genericReflectionInvariantField N m t hN hmPos hm hcop =
      genericReflectionFixedIntermediateField N m t hN hmPos hm hcop ht := by
  let : IsDomain (CoverRing N m t) := coverRing_isDomain N m t hN hmPos hm hcop
  let F := CoverFunctionField N m t
  let E : IntermediateField K F := genericReflectionInvariantField N m t hN hmPos hm hcop
  let R : IntermediateField K F := genericReflectionFixedIntermediateField
    N m t hN hmPos hm hcop ht
  have hle : E ≤ R := by
    intro z hz
    change z ∈ FixedPoints.subfield
      (Subgroup.zpowers
        (genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht)) F
    exact genericReflectionInvariantField_le_fixedField
      N m t hN hmPos hm hcop ht hz
  have htop : IntermediateField.adjoin E
      ({coverFunctionFieldX N m t} : Set F) = ⊤ :=
    genericReflectionInvariantField_adjoin_X_eq_top
      N m t hN hmPos hm hcop ht hodd
  have hxint : IsIntegral E (coverFunctionFieldX N m t) :=
    genericReflectionInvariantX_isIntegral N m t hN hmPos hm hcop ht
  let : FiniteDimensional E F := by
    have hdim : FiniteDimensional E
        (IntermediateField.adjoin E ({coverFunctionFieldX N m t} : Set F)) :=
      IntermediateField.adjoin.finiteDimensional hxint
    rw [htop] at hdim
    exact Module.Finite.of_surjective
      (IntermediateField.topEquiv : (⊤ : IntermediateField E F) ≃ₐ[E] F).toLinearMap
      (IntermediateField.topEquiv : (⊤ : IntermediateField E F) ≃ₐ[E] F).surjective
  have hE_le : Module.finrank E F ≤ 2 := by
    have hquad : Module.finrank E
        (IntermediateField.adjoin E ({coverFunctionFieldX N m t} : Set F)) ≤ 2 :=
      genericReflectionInvariantX_degree_le_two
      N m t hN hmPos hm hcop ht
    rw [htop] at hquad
    simpa only [IntermediateField.finrank_top'] using hquad
  have hR : Module.finrank R F = 2 := by
    change Module.finrank
      (FixedPoints.subfield (Subgroup.zpowers
        (genericReflectionFunctionFieldEquiv N m t hN hmPos hm hcop ht)) F) F = 2
    exact genericReflectionFixedField_finrank N m t hN hmPos hm hcop ht
  have hdiv : 2 ∣ Module.finrank E F := by
    rw [← hR]
    exact IntermediateField.finrank_dvd_of_le_left hle
  have hE : Module.finrank E F = 2 := by
    have hpos : 0 < Module.finrank E F := Module.finrank_pos
    obtain ⟨k, hk⟩ := hdiv
    omega
  exact IntermediateField.eq_of_le_of_finrank_eq' hle (by rw [hE, hR])

end HilbertModularity.Hypergeometric.EulerCover
