module

public import HilbertModularity.Monodromy.Matrices
public import HilbertModularity.LinearAlgebra.Semisimplification
public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup

@[expose] public section

/-! # Admissible rank-two monodromy triples

Irreducibility refers to the subgroup generated by the three matrices. The
semisimplification condition uses the commuting Jordan–Chevalley semisimple part.
-/

namespace HilbertModularity.Monodromy

open Matrix
open scoped MatrixGroups

/-- The admissibility conditions of [DarmonFibres, Definition 2.3] for an ordered special-linear triple. -/
structure AdmissibleTriple {K : Type*} [Field K] [CharZero K]
    (T : Fin 3 → SL(2, K)) : Prop where
  semisimple_parts : ∀ j, ∃ s : Module.End K (Fin 2 → K),
    s.IsSemisimple ∧ Commute (Matrix.toLinAlgEquiv' (T j : Matrix (Fin 2) (Fin 2) K)) s ∧
      IsNilpotent (Matrix.toLinAlgEquiv' (T j : Matrix (Fin 2) (Fin 2) K) - s) ∧ IsOfFinOrder s
  irreducible : ∀ W : Submodule K (Fin 2 → K),
    (∀ g ∈ Subgroup.closure (Set.range T), ∀ v ∈ W,
      (g : Matrix (Fin 2) (Fin 2) K) *ᵥ v ∈ W) → W = ⊥ ∨ W = ⊤
  product_eq_one : T 0 * T 1 * T 2 = 1

/-- The standard triple, now as elements of the special linear group. -/
noncomputable def standardTriple {R : Type*} [CommRing R] (τ : R) : Fin 3 → SL(2, R) :=
  ![⟨U0, det_U0⟩, ⟨U1 τ, det_U1 τ⟩, ⟨Uinf τ, det_Uinf τ⟩]

private theorem matrix_exists_finiteOrder_semisimple_part_of_unipotent
    {K : Type*} [Field K] (M : Matrix (Fin 2) (Fin 2) K) (hM : (M - 1) ^ 2 = 0) :
    ∃ s : Module.End K (Fin 2 → K), s.IsSemisimple ∧
      Commute (Matrix.toLinAlgEquiv' M) s ∧
      IsNilpotent (Matrix.toLinAlgEquiv' M - s) ∧ IsOfFinOrder s := by
  apply Module.End.exists_finiteOrder_semisimple_part_of_unipotent
  refine ⟨2, ?_⟩
  simpa only [map_pow, map_sub, map_one, map_zero] using
    congrArg (Matrix.toLinAlgEquiv' : Matrix (Fin 2) (Fin 2) K ≃ₐ[K] _) hM

/-- A nontrivial two-unipotent triple is admissible if its infinity monodromy has finite order. -/
theorem standardTriple_admissible_of_pow {K : Type*} [Field K] [CharZero K]
    (τ : K) (hτ : τ ≠ 2) (N : ℕ) (hN : 0 < N) (hpow : Uinf τ ^ N = 1) :
    AdmissibleTriple (standardTriple τ) := by
  refine ⟨?_, ?_, ?_⟩
  · intro j
    fin_cases j
    · exact matrix_exists_finiteOrder_semisimple_part_of_unipotent U0 (U0_unipotent (R := K)).2
    · exact matrix_exists_finiteOrder_semisimple_part_of_unipotent (U1 τ) (U1_unipotent τ hτ).2
    · apply Module.End.exists_finiteOrder_semisimple_part_of_pow_eq_one _ N hN
      change Matrix.toLinAlgEquiv' (Uinf τ) ^ N = 1
      simpa only [map_pow, map_one] using
        congrArg (Matrix.toLinAlgEquiv' : Matrix (Fin 2) (Fin 2) K ≃ₐ[K] _) hpow
  · intro W hW
    apply invariant_submodule_eq_bot_or_top τ hτ W
    · intro v hv
      exact hW (standardTriple τ 0) (Subgroup.subset_closure ⟨0, rfl⟩) v hv
    · intro v hv
      exact hW (standardTriple τ 1) (Subgroup.subset_closure ⟨1, rfl⟩) v hv
  · apply Subtype.ext
    exact U0_mul_U1_mul_Uinf τ

/-- The root-labelled standard triple is admissible. -/
theorem standardTriple_admissible {K : Type*} [Field K] [CharZero K]
    {N : ℕ} (hN : 3 ≤ N) {ζ : K} (hζ : IsPrimitiveRoot ζ N)
    {m : ℕ} (hm : m.Coprime N) : AdmissibleTriple (standardTriple (ζ ^ m + ζ⁻¹ ^ m)) := by
  apply standardTriple_admissible_of_pow _ (tau_ne_two hN hζ hm) N (by omega)
  have h := pow_orderOf_eq_one (Uinf (ζ ^ m + ζ⁻¹ ^ m))
  rwa [orderOf_Uinf hN hζ hm] at h

end HilbertModularity.Monodromy
