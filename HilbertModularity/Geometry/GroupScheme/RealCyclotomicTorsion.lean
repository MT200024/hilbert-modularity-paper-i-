module

public import HilbertModularity.NumberTheory.RealCyclotomicPrime
public import HilbertModularity.Geometry.GroupScheme.PrimeKernel
public import HilbertModularity.Geometry.GroupScheme.PrimeCyclotomic
public import HilbertModularity.Geometry.GroupScheme.CoefficientIsogeny

/-! # Actual torsion at the canonical real cyclotomic prime

An actual integral real-multiplication action supplies the Tate lattice and
scheme kernel at the canonical prime generated by `2 - tau(1)`. Its generator,
residue field and total ramification are proved arithmetic data, not inputs.
See [TripathiGoswami].
-/

@[expose] public noncomputable section

open CategoryTheory HilbertModularity.Cyclotomic
open scoped CategoryTheory.MonObj NumberField

namespace AlgebraicGeometry.GroupScheme

universe u

variable (K : Type u) [Field K]
  (A : CommGrp (Over (Spec (CommRingCat.of K))))
  (p : ℕ) [Fact p.Prime] (hp : p ≠ 2)
  (φ : 𝓞 (realCyclotomicField p) →+* End A)

local notation "Rₚ" => 𝓞 (realCyclotomicField p)
local notation "Pₚ" => Ideal.span {realPrimeGenerator p}
local notation "Sₚ" => AdicCompletion Pₚ Rₚ

/-- The canonical real-prime completion acts on the actual integral Tate module. -/
@[instance_reducible]
def realPrimeIntegralTateModule : Module Sₚ (integralTate K A.X p) := by
  letI := pointsCoefficientModule K A Rₚ φ
  exact TateModule.coefficientPrimeModule p Rₚ (Points K (AlgebraicClosure K) A.X)
    Pₚ ((p - 1) / 2) (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)

/-- The actual Galois representation on the canonical real-prime integral lattice. -/
def realPrimeIntegralTateRepresentation :
    letI := realPrimeIntegralTateModule K A p hp φ
    Representation Sₚ (AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) (integralTate K A.X p) := by
  letI := pointsCoefficientModule K A Rₚ φ
  exact primeIntegralTateRepresentation K A.X Rₚ (pointsCoefficientModule_realized K A Rₚ φ)
    p Pₚ ((p - 1) / 2) (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)

variable [IsFinite (multiplicationMap K A.X p).left] [Surjective (multiplicationMap K A.X p).left]

/-- The canonical real-prime lattice is finite over its actual integral completion. -/
theorem realPrimeIntegralTate_finite :
    letI := realPrimeIntegralTateModule K A p hp φ
    Module.Finite Sₚ (integralTate K A.X p) := by
  let := pointsCoefficientModule K A Rₚ φ
  exact primeIntegralTate_finite K A.X Rₚ p Pₚ ((p - 1) / 2)
    (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)

/-- The canonical real-prime lattice is free, with all prime arithmetic discharged. -/
theorem realPrimeIntegralTate_free :
    letI := realPrimeIntegralTateModule K A p hp φ
    Module.Free Sₚ (integralTate K A.X p) := by
  let := pointsCoefficientModule K A Rₚ φ
  have := realPrimeGenerator_isMaximal p hp
  exact primeIntegralTate_free_of_domain K A.X Rₚ p
    (realPrimeGenerator p) (realPrimeCofactor p hp) (realPrimeGenerator_ne_zero p hp)
    (realPrimeGenerator_mul_cofactor p hp) ((p - 1) / 2)
    (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)

/-- The actual canonical-prime Tate reduction is the Galois action on its actual scheme-kernel points. -/
def realPrimeResidualKernelEquiv :
    letI := realPrimeIntegralTateModule K A p hp φ
    letI := coefficientKernelModule K A Rₚ φ (realPrimeGenerator p)
    letI := (AdicCompletion.evalOneₐ Pₚ).toRingHom.toAlgebra
    ((realPrimeIntegralTateRepresentation K A p hp φ).baseChange (Rₚ ⧸ Pₚ)).Equiv
      (coefficientKernelRepresentation K A Rₚ φ (realPrimeGenerator p)) := by
  letI := pointsCoefficientModule K A Rₚ φ
  exact primeResidualKernelEquiv K A Rₚ φ p (realPrimeGenerator p) (realPrimeCofactor p hp)
    (realPrimeGenerator_mul_cofactor p hp) ((p - 1) / 2)
    (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)

/-- The determinant on actual canonical-prime kernel points is the residue of the actual lattice determinant. -/
theorem det_realPrimeKernel (g : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
    letI := realPrimeIntegralTateModule K A p hp φ
    letI := coefficientKernelModule K A Rₚ φ (realPrimeGenerator p)
    LinearMap.det (coefficientKernelRepresentation K A Rₚ φ (realPrimeGenerator p) g) =
      AdicCompletion.evalOneₐ Pₚ (LinearMap.det (realPrimeIntegralTateRepresentation K A p hp φ g)) := by
  let := pointsCoefficientModule K A Rₚ φ
  let := realPrimeIntegralTateModule K A p hp φ
  let := coefficientKernelModule K A Rₚ φ (realPrimeGenerator p)
  have := realPrimeGenerator_isMaximal p hp
  rw [det_coefficientKernelRepresentation]
  exact det_coefficientTorsion_of_principal_prime K A.X Rₚ p
    (pointsCoefficientModule_realized K A Rₚ φ) (realPrimeGenerator p) (realPrimeCofactor p hp)
    (realPrimeGenerator_ne_zero p hp) (realPrimeGenerator_mul_cofactor p hp)
    ((p - 1) / 2) (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp) g

/-- An exact cyclotomic determinant after an injective coefficient extension gives the native mod-p determinant on actual canonical-prime kernel points. -/
theorem det_realPrimeKernel_eq_cyclotomic
    (L : Type*) [Field L] [Algebra Sₚ L] [FaithfulSMul Sₚ L]
    (g : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K)
    (hd :
      letI := realPrimeIntegralTateModule K A p hp φ
      LinearMap.det ((realPrimeIntegralTateRepresentation K A p hp φ).baseChange L g) =
        algebraMap Sₚ L
          (TateModule.coefficientPrimeRingEquiv p Rₚ Pₚ ((p - 1) / 2)
            (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)
              (PadicInt.toAdicCompletion p Rₚ (Field.cyclotomicCharacter K p g : ℤ_[p])))) :
    letI := coefficientKernelModule K A Rₚ φ (realPrimeGenerator p)
    realPrimeResidueEquiv p hp
      (LinearMap.det (coefficientKernelRepresentation K A Rₚ φ (realPrimeGenerator p) g)) =
        (Field.cyclotomicCharacter K p g : ℤ_[p]).toZMod := by
  let := realPrimeIntegralTateModule K A p hp φ
  let := coefficientKernelModule K A Rₚ φ (realPrimeGenerator p)
  have := realPrimeIntegralTate_finite K A p hp φ
  have := realPrimeIntegralTate_free K A p hp φ
  have := realPrimeGenerator_isMaximal p hp
  have := AdicCompletion.isDomain_of_isMaximal_span
    (realPrimeGenerator p) (realPrimeGenerator_ne_zero p hp)
  have hdet : LinearMap.det (realPrimeIntegralTateRepresentation K A p hp φ g) =
      TateModule.coefficientPrimeRingEquiv p Rₚ Pₚ ((p - 1) / 2)
        (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)
          (PadicInt.toAdicCompletion p Rₚ (Field.cyclotomicCharacter K p g : ℤ_[p])) := by
    apply FaithfulSMul.algebraMap_injective Sₚ L
    exact (LinearMap.det_baseChange (realPrimeIntegralTateRepresentation K A p hp φ g)).symm.trans hd
  rw [det_realPrimeKernel K A p hp φ, hdet,
    TateModule.coefficientPrimeRingEquiv_padic_residue p Rₚ
      (realPrimeGenerator p) (realPrimeCofactor p hp) (realPrimeGenerator_mul_cofactor p hp)
      ((p - 1) / 2) (realPrimeRamification_pos p hp) (span_realPrimeGenerator_pow p hp)
      (realPrimeResidueEquiv p hp).symm.toRingHom]
  exact (realPrimeResidueEquiv p hp).apply_symm_apply _

attribute [local instance] Scheme.finiteEtaleCartesianMonoidalCategory
  Scheme.finiteEtaleBraidedCategory

/-- The canonical real-prime kernel is an actual finite étale group scheme when multiplication by p is finite étale. -/
def realPrimeFiniteEtaleKernel [IsSeparated A.X.hom]
    [IsFinite (p • 𝟙 A).hom.hom.hom.left] [Etale (p • 𝟙 A).hom.hom.hom.left] :
    CommGrp (Spec (CommRingCat.of K)).FiniteEtale :=
  finiteEtaleCoefficientKernel A Rₚ φ p (realPrimeGenerator p) (realPrimeCofactor p hp)
    (realPrimeGenerator_mul_cofactor p hp)

end AlgebraicGeometry.GroupScheme
